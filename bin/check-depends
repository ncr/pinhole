#!/usr/bin/env python3
"""What a source installation needs from the system, said before it builds.

The package's `depends` (pkgbuild/PKGBUILD) are what Pinhole runs with. A
source installation is no package, so pacman does not know it needs them:
one installed only for another package goes when that one is removed with
`pacman -Rns` (as libheif went with imv), and Pinhole no longer starts.
This says which are not installed and which pacman holds only for another
package, with the one command that installs and keeps them all. It never
runs that command (an installation for one account asks no root password)
and never fails the installation. Without pacman it says nothing.
"""
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

PKGBUILD = Path(__file__).resolve().parents[1] / "pkgbuild" / "PKGBUILD"


def depends(text):
    """The names in the PKGBUILD's depends=(…), without version bounds."""
    found = re.search(r"^depends=\((.*?)\)", text, re.S | re.M)
    if not found:
        return []
    names = re.findall(r"""['"]?([^\s'"()]+)['"]?""", found.group(1))
    return [re.split(r"[<>=]", name)[0] for name in names]


def pacman(pacman_command, *arguments):
    result = subprocess.run([pacman_command, *arguments], capture_output=True, text=True)
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def main():
    pacman_command = os.environ.get("PINHOLE_PACMAN") or shutil.which("pacman")
    if not pacman_command:
        return 0
    names = depends(PKGBUILD.read_text())
    if not names:
        return 0
    # -T: those nothing installed satisfies (a provider counts).
    missing = [name for name in pacman(pacman_command, "-T", *names) if name in names]
    # -Qqd: installed as another package's dependency only. Asked one by
    # one, since a name satisfied by a provider is no package of its own.
    loose = [name for name in names if name not in missing
             and pacman(pacman_command, "-Qqd", name) == [name]]
    if not missing and not loose:
        return 0
    said = []
    if missing:
        said.append(f"Pinhole needs {', '.join(missing)}, which {'is' if len(missing) == 1 else 'are'} not installed")
    if loose:
        said.append(f"pacman holds {', '.join(loose)} only for other packages, and removing those "
                    f"can take {'it' if len(loose) == 1 else 'them'} too")
    print(f"Warning: {'; '.join(said)}.", file=sys.stderr)
    command = ["sudo", "pacman", "-S", "--needed", "--asexplicit", *missing, *loose]
    print(f"  Install and keep them: {shlex.join(command)}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
