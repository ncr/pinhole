#!/usr/bin/env python3
"""Restart only windows belonging to this install, after successful activation."""
import os
import json
from pathlib import Path
import signal
import subprocess
import sys
import time


def identity(process):
    # The start time prevents signalling a different process after PID reuse.
    return (process / 'stat').read_text().rsplit(')', 1)[1].split()[19]


def running(process, started):
    try:
        stat = (process / 'stat').read_text().rsplit(')', 1)[1].split()
        return stat[0] != 'Z' and stat[19] == started
    except (OSError, IndexError):
        return False


def stop(processes):
    for process, started in processes:
        if running(process, started):
            try:
                os.kill(int(process.name), signal.SIGTERM)
            except ProcessLookupError:
                pass
    deadline = time.monotonic() + 10
    while any(running(process, started) for process, started in processes):
        if time.monotonic() >= deadline:
            raise RuntimeError('Pinhole did not close in time; no replacement window was started.')
        time.sleep(.05)

def session(process):
    env = dict(item.split('=', 1) for item in
               os.fsdecode((process / 'environ').read_bytes()).split('\0') if '=' in item)
    return env, os.readlink(process / 'cwd')


def launch(program, args, env, cwd, logfile):
    home = Path(env.get('HOME') or Path.home())
    state = Path(env.get('XDG_STATE_HOME') or home / '.local/state') / 'pinhole'
    state.mkdir(parents=True, exist_ok=True)
    with (state / logfile).open('ab') as log:
        subprocess.Popen([str(program), *args],
                         cwd=cwd if Path(cwd).is_dir() else home, env=env,
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                         start_new_session=True, close_fds=True)


def background_index_enabled(prefix, env):
    home = Path(env.get('HOME') or Path.home())
    config = Path(env.get('XDG_CONFIG_HOME') or home / '.config') / 'pinhole'
    builtin = Path(env.get('PINHOLE_BUILTIN_PLUGINS') or prefix / 'lib/pinhole/plugins')
    try:
        settings = json.loads((config / 'plugins.json').read_text())
        switches = settings.get('enabled') or {}
    except (OSError, ValueError, AttributeError):
        switches = {}
    if not isinstance(switches, dict):
        switches = {}
    return (switches.get('me.semantic-search') is True
            or (switches.get('me.people') is not False and (builtin / 'people/pinhole-faces').is_file()))


def restart(prefix, checkout):
    prefix, checkout = Path(prefix).resolve(), Path(checkout).resolve()
    executables = {str(prefix / 'bin/pinhole'), str(checkout / 'app/build/pinhole')}
    executables.add(str((prefix / 'bin/pinhole').resolve()))
    runtime = os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
    sockets = {os.environ.get('PINHOLE_SOCKET', runtime + '/pinhole.sock')}
    windows, daemons = [], []
    for process in Path('/proc').iterdir():
        if not process.name.isdigit():
            continue
        try:
            if process.stat().st_uid != os.getuid():
                continue
            started = identity(process)
            argv = (process / 'cmdline').read_bytes().rstrip(b'\0').split(b'\0')
            executable = os.readlink(process / 'exe').removesuffix(' (deleted)')
            if executable in executables:
                env, cwd = session(process)
                window_runtime = env.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
                sockets.add(env.get('PINHOLE_SOCKET', window_runtime + '/pinhole.sock'))
                windows.append((process, started, [os.fsdecode(arg) for arg in argv[1:]], env, cwd))
            elif Path(executable).name == 'pinholed' and b'--socket' in argv:
                socket = os.fsdecode(argv[argv.index(b'--socket') + 1])
                env, cwd = session(process)
                daemons.append((process, started, socket, [os.fsdecode(arg) for arg in argv[1:]], env, cwd))
        except (OSError, IndexError):
            continue
    stop([(process, started) for process, started, *_ in windows])
    daemons = [daemon for daemon in daemons if daemon[2] in sockets]
    stop([(process, started) for process, started, *_ in daemons])
    for _, _, args, env, cwd in windows:
        launch(prefix / 'bin/pinhole', args, env, cwd, 'install-restart.log')
    if windows:
        print('Restarted Pinhole after installation.')
    else:
        for _, _, _, args, env, cwd in daemons:
            if '--given' not in args and background_index_enabled(prefix, env):
                launch(prefix / 'bin/pinholed', args, env, cwd, 'pinholed.log')
                print('Restarted Pinhole background indexing service.')


if __name__ == '__main__':
    try:
        restart(*sys.argv[1:])
    except (OSError, RuntimeError) as error:
        print(f'Installed Pinhole, but could not restart it: {error}', file=sys.stderr)
        sys.exit(1)
