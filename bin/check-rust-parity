#!/usr/bin/env python3
"""Explicit Blaze/Cargo JPEG and SIMD correctness comparison; never a build fallback."""
import os
from pathlib import Path
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = ROOT / 'docs/reviews/jpeg-repro/Cargo.toml'
WRAPPER = str(ROOT / 'bin/build-rust')
base_env = dict(os.environ, PINHOLE_RUST_BUILDER='blaze')
# Reuse only the immutable toolchain, so this check can stop its own workers
# without interrupting an app build or leaving daemons behind after cleanup.
toolchain = Path(subprocess.check_output([WRAPPER, 'toolchain', '--path'],
                                        cwd=ROOT, env=base_env, text=True).strip().splitlines()[-1])
with tempfile.TemporaryDirectory(prefix='pinhole-rust-parity-') as temporary:
    scratch = Path(temporary)
    home = scratch / 'state' / (ROOT / 'bin/blaze-version').read_text().strip()
    home.mkdir(parents=True)
    (home / 'toolchains').symlink_to(toolchain.parent, target_is_directory=True)
    base_env |= {'BLAZE_HOME': str(scratch / 'state'), 'BLAZE_CACHE': str(scratch / 'store')}
    try:
        for mode, flags in [('simd', []), ('scalar', ['--no-default-features'])]:
            outputs = []
            for builder in ('blaze', 'cargo'):
                destination = scratch / f'{builder}-{mode}'
                env = dict(base_env, PINHOLE_RUST_BUILDER=builder, BLAZE_TESTS='all',
                           CARGO_TARGET_DIR=str(scratch / f'target-{builder}-{mode}'))
                for key in ('BLAZE_BACKEND', 'BLAZE_OPT', 'BLAZE_INLINE', 'BLAZE_LIBRARY', 'BLAZE_LIBRARY_FROM'):
                    env.pop(key, None)
                subprocess.run([WRAPPER, 'run', '--release', '--locked', '--manifest-path',
                                str(MANIFEST), *flags, '--', str(destination)],
                               cwd=ROOT, env=env, check=True)
                outputs.append({path.name: path.read_bytes() for path in destination.glob('*.raw')})
            if not outputs[0] or outputs[0].keys() != outputs[1].keys():
                raise SystemExit(f'{mode}: missing or mismatched decoder output files')
            differences = [name for name in outputs[0] if outputs[0][name] != outputs[1][name]]
            if differences:
                raise SystemExit(f'{mode}: Blaze/Cargo decoded bytes differ: {differences}')
            print(f'{mode}: {len(outputs[0])} JPEG fixtures match Cargo byte for byte; SIMD packing passed.', flush=True)
    finally:
        subprocess.run([WRAPPER, 'stop'], cwd=ROOT, env=base_env, check=False)
