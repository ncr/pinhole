#!/bin/sh
# Builds this checkout and installs it into ~/.local, for whoever works on
# Pinhole on this computer: no root and no package (bin/install makes the
# package). The launcher's entry there runs it by its full path, since
# /usr/bin comes before ~/.local/bin on Hyprland's PATH and a packaged
# Pinhole may still be there. A window and its pinholed already running are
# stopped, so the next launch is the new one.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PREFIX="${PREFIX:-$HOME/.local}"
cd "$ROOT"

cargo build --release --locked --manifest-path core/Cargo.toml
cargo build --release --locked --manifest-path plugins/series/finder/Cargo.toml
cargo build --release --locked --manifest-path plugins/send/sender/Cargo.toml
app/bin/build

"$ROOT/bin/install-files" "$PREFIX"
sed -i "s|^Exec=.*|Exec=$PREFIX/bin/pinhole|" "$PREFIX/share/applications/pinhole.desktop"
update-desktop-database "$PREFIX/share/applications" 2>/dev/null || true

# Only the installed ones: windows run from a checkout (self-tests, other
# worktrees) and the services they started on sockets of their own stay.
for pid in $(pgrep -x pinhole || true); do
  case "$(readlink "/proc/$pid/exe" || true)" in
    /usr/bin/pinhole* | "$PREFIX"/bin/pinhole*) kill "$pid" || true ;;
  esac
done
socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pinhole.sock"
for pid in $(pgrep -x pinholed || true); do
  tr '\0' ' ' < "/proc/$pid/cmdline" | grep -q -- "--socket $socket " && kill "$pid" || true
done

echo "Installed $(git rev-parse --short HEAD) into $PREFIX"
