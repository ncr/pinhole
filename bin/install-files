#!/bin/sh
# Puts a built checkout's files under a prefix: "$pkgdir/usr" for the package,
# ~/.local for bin/install-local. The layout is the same either way, so the
# window finds its plugins in <prefix>/lib/pinhole and its helpers beside it.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PREFIX="$1"
cd "$ROOT"

install -Dm755 app/build/pinhole "$PREFIX/bin/pinhole"
install -Dm755 core/target/release/pinholed "$PREFIX/bin/pinholed"
# pinhole-sync was the commands before `pinhole <command>`, and wrote the
# library itself: gone, so nothing but pinholed writes it.
rm -f "$PREFIX/bin/pinhole-sync"
# The sign-in provider: a uv script that fetches icloudpd into uv's cache
# on first use (see auth/PROTOCOL.md).
install -Dm755 auth/pyicloud/pinhole-auth "$PREFIX/bin/pinhole-auth"
# Pinhole's own plugins (docs/plugins.md), each its folder as it is in the
# checkout, with its helpers built.
install -d "$PREFIX/lib/pinhole/plugins/series/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/series" plugins/series/manifest.json plugins/series/*.qml \
  plugins/series/Engine.js plugins/series/grain.png
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/series/i18n" plugins/series/i18n/*.json
install -Dm755 plugins/series/finder/target/release/pinhole-series "$PREFIX/lib/pinhole/plugins/series/pinhole-series"
install -d "$PREFIX/lib/pinhole/plugins/background/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/background" plugins/background/manifest.json plugins/background/*.qml
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/background/i18n" plugins/background/i18n/*.json
install -Dm755 -t "$PREFIX/lib/pinhole/plugins/background" plugins/background/background
install -d "$PREFIX/lib/pinhole/plugins/onthisday/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/onthisday" plugins/onthisday/manifest.json plugins/onthisday/*.qml
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/onthisday/i18n" plugins/onthisday/i18n/*.json
install -d "$PREFIX/lib/pinhole/plugins/calendar/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/calendar" plugins/calendar/manifest.json plugins/calendar/*.qml \
  plugins/calendar/CalendarDays.js
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/calendar/i18n" plugins/calendar/i18n/*.json
install -d "$PREFIX/lib/pinhole/plugins/sheet/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/sheet" plugins/sheet/manifest.json plugins/sheet/*.qml plugins/sheet/Layout.js plugins/sheet/sRGB.icc
# Their files by their old names, which shared another's words: gone.
rm -f "$PREFIX/lib/pinhole/plugins/calendar/Days.js" "$PREFIX/lib/pinhole/plugins/sheet/Studio.qml"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/sheet/i18n" plugins/sheet/i18n/*.json
install -d "$PREFIX/lib/pinhole/plugins/send/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/send" plugins/send/manifest.json plugins/send/*.qml
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/send/i18n" plugins/send/i18n/*.json
install -Dm755 plugins/send/sender/target/release/pinhole-send "$PREFIX/lib/pinhole/plugins/send/pinhole-send"
install -d "$PREFIX/lib/pinhole/plugins/info/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/info" plugins/info/manifest.json plugins/info/*.qml plugins/info/*.js
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/info/i18n" plugins/info/i18n/*.json
install -Dm755 plugins/info/pinhole-info "$PREFIX/lib/pinhole/plugins/info/pinhole-info"
install -d "$PREFIX/lib/pinhole/plugins/colour/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/colour" plugins/colour/manifest.json plugins/colour/*.qml plugins/colour/Colour.js
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/colour/i18n" plugins/colour/i18n/*.json
install -d "$PREFIX/lib/pinhole/plugins/theme/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/theme" plugins/theme/manifest.json plugins/theme/*.qml plugins/theme/Palette.js
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/theme/i18n" plugins/theme/i18n/*.json
install -Dm755 plugins/theme/pinhole-theme "$PREFIX/lib/pinhole/plugins/theme/pinhole-theme"
install -d "$PREFIX/lib/pinhole/plugins/screenshots/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/screenshots" plugins/screenshots/manifest.json plugins/screenshots/*.qml \
  plugins/screenshots/Find.js
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/screenshots/i18n" plugins/screenshots/i18n/*.json
install -d "$PREFIX/lib/pinhole/plugins/frame/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/frame" plugins/frame/manifest.json plugins/frame/*.qml
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/frame/i18n" plugins/frame/i18n/*.json
install -Dm644 pkgbuild/pinhole.svg "$PREFIX/share/icons/hicolor/scalable/apps/pinhole.svg"
install -Dm644 pkgbuild/pinhole.desktop "$PREFIX/share/applications/pinhole.desktop"
