#!/bin/sh
# Puts a built checkout's files under a prefix: "$pkgdir/usr" for the package,
# ~/.local for bin/install --local. The layout is the same either way, so the
# window finds its plugins in <prefix>/lib/pinhole and its helpers beside it.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PREFIX="$1"
cd "$ROOT"
install -d "$PREFIX"
DESTINATION="$(CDPATH= cd -- "$PREFIX" && pwd)"
PINHOLE_RUNTIME_PREFIX="${PINHOLE_RUNTIME_PREFIX:-$DESTINATION}"
export PINHOLE_RUNTIME_PREFIX
PREFIX="$(mktemp -d "$DESTINATION/.pinhole-install.XXXXXX")"
trap 'rm -rf "$PREFIX"' EXIT HUP INT TERM

# Replace executables by rename, so an update can leave the current app
# open until its owner chooses Restart (and never follows developer links).
put_program() {
  install -Dm755 "$1" "$2.new"
  mv -f "$2.new" "$2"
}
put_program app/build/pinhole "$PREFIX/bin/pinhole"
put_program core/target/release/pinholed "$PREFIX/bin/pinholed"
put_program bin/update "$PREFIX/bin/pinhole-update"
# iCloud's sign-in provider: a uv script that fetches icloudpd into uv's
# cache on first use (see plugins/icloud/auth/PROTOCOL.md). It is the
# pinhole.icloud plugin's, but goes beside pinholed, where pinholed looks
# for it.
put_program plugins/icloud/auth/pyicloud/pinhole-auth "$PREFIX/bin/pinhole-auth"
# Pinhole's own plugins (docs/plugins.md), each its folder as it is in the
# checkout, with its helpers built.
install -d "$PREFIX/lib/pinhole/plugins/series/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/series" plugins/series/manifest.json plugins/series/*.qml \
  plugins/series/Engine.js plugins/series/grain.png
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/series/i18n" plugins/series/i18n/*.json
install -Dm755 plugins/series/finder/target/release/pinhole-series "$PREFIX/lib/pinhole/plugins/series/pinhole-series"
install -d "$PREFIX/lib/pinhole/plugins/live/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/live" plugins/live/manifest.json plugins/live/*.qml
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/live/i18n" plugins/live/i18n/*.json
# Its effects, made with ffmpeg as its manifest's "makes" says.
install -Dm755 plugins/live/live-effect "$PREFIX/lib/pinhole/plugins/live/live-effect"
install -d "$PREFIX/lib/pinhole/plugins/edit/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/edit" plugins/edit/manifest.json plugins/edit/*.qml
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/edit/i18n" plugins/edit/i18n/*.json
install -d "$PREFIX/lib/pinhole/plugins/favourites/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/favourites" plugins/favourites/manifest.json plugins/favourites/*.qml
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/favourites/i18n" plugins/favourites/i18n/*.json
# The sources' plugins: their QML, here; their Rust is linked into pinholed.
install -d "$PREFIX/lib/pinhole/plugins/icloud/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/icloud" plugins/icloud/manifest.json plugins/icloud/*.qml
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/icloud/i18n" plugins/icloud/i18n/*.json
install -d "$PREFIX/lib/pinhole/plugins/folder/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/folder" plugins/folder/manifest.json plugins/folder/*.qml
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/folder/i18n" plugins/folder/i18n/*.json
install -d "$PREFIX/lib/pinhole/plugins/background/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/background" plugins/background/manifest.json plugins/background/*.qml
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/background/i18n" plugins/background/i18n/*.json
install -Dm755 -t "$PREFIX/lib/pinhole/plugins/background" plugins/background/background
install -d "$PREFIX/lib/pinhole/plugins/onthisday/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/onthisday" plugins/onthisday/manifest.json plugins/onthisday/*.qml
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/onthisday/i18n" plugins/onthisday/i18n/*.json
install -d "$PREFIX/lib/pinhole/plugins/calendar/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/calendar" plugins/calendar/manifest.json plugins/calendar/*.qml \
  plugins/calendar/CalendarDays.js
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/calendar/i18n" plugins/calendar/i18n/*.json
install -d "$PREFIX/lib/pinhole/plugins/sheet/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/sheet" plugins/sheet/manifest.json plugins/sheet/*.qml plugins/sheet/Layout.js plugins/sheet/sRGB.icc
# Their files by their old names, which shared another's words: gone.
rm -f "$PREFIX/lib/pinhole/plugins/calendar/Days.js" "$PREFIX/lib/pinhole/plugins/sheet/Studio.qml"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/sheet/i18n" plugins/sheet/i18n/*.json
install -d "$PREFIX/lib/pinhole/plugins/send/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/send" plugins/send/manifest.json plugins/send/*.qml
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/send/i18n" plugins/send/i18n/*.json
install -Dm755 plugins/send/sender/target/release/pinhole-send "$PREFIX/lib/pinhole/plugins/send/pinhole-send"
install -d "$PREFIX/lib/pinhole/plugins/info/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/info" plugins/info/manifest.json plugins/info/*.qml plugins/info/*.js
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/info/i18n" plugins/info/i18n/*.json
install -Dm755 plugins/info/pinhole-info "$PREFIX/lib/pinhole/plugins/info/pinhole-info"
# Its native QML module (the map), as app/bin/build made it.
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/info/qml/Pinhole/Internal/Info" plugins/info/qml/Pinhole/Internal/Info/qmldir
install -Dm755 -t "$PREFIX/lib/pinhole/plugins/info/qml/Pinhole/Internal/Info" plugins/info/qml/Pinhole/Internal/Info/libpinholeinfo.so
# Colours, which Mosaic took the place of: gone.
rm -rf "$PREFIX/lib/pinhole/plugins/colour"
install -d "$PREFIX/lib/pinhole/plugins/mosaic/i18n"
# Its shader as app/bin/build baked it.
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/mosaic" plugins/mosaic/manifest.json plugins/mosaic/*.qml plugins/mosaic/Mosaic.js \
  plugins/mosaic/mosaic.frag.qsb
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/mosaic/i18n" plugins/mosaic/i18n/*.json
install -Dm755 plugins/mosaic/pinhole-mosaic "$PREFIX/lib/pinhole/plugins/mosaic/pinhole-mosaic"
install -d "$PREFIX/lib/pinhole/plugins/wall/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/wall" plugins/wall/manifest.json plugins/wall/*.qml plugins/wall/Colour.js
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/wall/i18n" plugins/wall/i18n/*.json
install -d "$PREFIX/lib/pinhole/plugins/theme/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/theme" plugins/theme/manifest.json plugins/theme/*.qml plugins/theme/Palette.js
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/theme/i18n" plugins/theme/i18n/*.json
install -Dm755 plugins/theme/pinhole-theme "$PREFIX/lib/pinhole/plugins/theme/pinhole-theme"
install -d "$PREFIX/lib/pinhole/plugins/screenshots/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/screenshots" plugins/screenshots/manifest.json plugins/screenshots/*.qml
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/screenshots/i18n" plugins/screenshots/i18n/*.json
install -d "$PREFIX/lib/pinhole/plugins/frame/i18n"
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/frame" plugins/frame/manifest.json plugins/frame/*.qml
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/frame/i18n" plugins/frame/i18n/*.json
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/people" plugins/people/manifest.json plugins/people/*.qml
install -Dm644 -t "$PREFIX/lib/pinhole/plugins/people/i18n" plugins/people/i18n/*.json
install -Dm755 plugins/people/pinhole-faces "$PREFIX/lib/pinhole/plugins/people/pinhole-faces"
# Omarchy's bar widget: the newest photos, to drag out (omarchy-bar/).
install -Dm644 -t "$PREFIX/lib/pinhole/omarchy-bar" omarchy-bar/manifest.json omarchy-bar/qmldir omarchy-bar/*.qml
install -Dm755 -t "$PREFIX/lib/pinhole/omarchy-bar" omarchy-bar/open-here
install -Dm644 -t "$PREFIX/lib/pinhole/omarchy-bar/i18n" omarchy-bar/i18n/*.json
# An sRGB profile, for plugins to make a picture sRGB with (pinhole.srgbProfile).
install -Dm644 app/assets/sRGB.icc "$PREFIX/share/pinhole/sRGB.icc"
install -Dm644 pkgbuild/pinhole.svg "$PREFIX/share/icons/hicolor/scalable/apps/pinhole.svg"
install -Dm644 pkgbuild/pinhole.desktop "$PREFIX/share/applications/pinhole.desktop"
# Pinhole's license, and those of the crates its programs link (bin/build).
install -Dm644 LICENSE "$PREFIX/share/licenses/pinhole/LICENSE"
install -Dm644 app/build/THIRD-PARTY-NOTICES.txt "$PREFIX/share/licenses/pinhole/THIRD-PARTY-NOTICES.txt"
if [ "${PINHOLE_INSTALL_MODE:-local}" != package ]; then
  python3 - "$PREFIX/share/applications/pinhole.desktop" "$PINHOLE_RUNTIME_PREFIX/bin/pinhole" <<'PY'
from pathlib import Path
import sys
entry = Path(sys.argv[1])
command = sys.argv[2].replace('\\', '\\\\').replace('"', '\\"').replace('`', '\\`').replace('$', '\\$').replace('%', '%%')
entry.write_text(entry.read_text().replace('Exec=pinhole', 'Exec="' + command + '"'))
PY
fi
"$ROOT/bin/install-metadata" "$PREFIX"
"$ROOT/bin/install-record" "$PREFIX"
# Only a complete staged tree can replace the running installation.
"$ROOT/bin/activate-install" "$PREFIX" "$DESTINATION"
