#!/bin/sh
# Source installation; binary packages belong to the OS package manager.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
cd "$ROOT"
mode=developer
interactive=1
while [ "$#" -gt 0 ]; do
    case "$1" in
        --dev | --developer) ;; # Compatibility with developer update helpers.
        --uninstall) mode=uninstall ;;
        --non-interactive | --yes) interactive=0 ;;
        --help | -h)
            cat <<'HELP'
Usage: bin/install [--uninstall] [--non-interactive]

Build this checkout and link Pinhole into ~/.local. No package or root password.
Running Pinhole windows reopen automatically after a successful installation.

  --uninstall Remove this account's installation; keep photos and settings.
  --non-interactive Skip the terminal menu and progress display.

PREFIX changes ~/.local. --dev is accepted for older update helpers.
Install and update binary packages with your OS package manager instead.
HELP
            exit 0 ;;
        *) echo "Unknown option: $1 (see --help)." >&2; exit 2 ;;
    esac
    shift
done
# One account's installation, from a checkout that account can change: as
# root, it would make what every account runs that checkout owner's to change.
if [ "$(id -u)" -eq 0 ]; then
    echo 'Run bin/install as yourself, not as root: it installs for your account alone. For every account, use the package.' >&2
    exit 2
fi
ui=0
if [ "$interactive" = 1 ] && [ -t 0 ] && [ -t 1 ] && command -v gum >/dev/null 2>&1; then ui=1; fi
if [ "$ui" = 1 ]; then
    gum style --border rounded --border-foreground 75 --padding '1 3' \
        --bold '◉  Pinhole' 'Your photos. Close at hand.'
    if [ "$mode" != uninstall ]; then
        choice="$(gum choose --header 'Pinhole from source' \
            'Install · build and run this checkout' 'Uninstall · remove this account’s installation')" || exit 130
        case "$choice" in Install*) ;; Uninstall*) mode=uninstall ;; *) exit 130 ;; esac
    fi
fi
if [ "${PINHOLE_UPDATE_LOCK_HELD:-0}" != 1 ]; then
    state="${XDG_STATE_HOME:-$HOME/.local/state}/pinhole"
    mkdir -p "$state"
    key="$(printf '%s' "$ROOT" | sha256sum | cut -c1-16)"
    exec 9>"$state/update-$key.lock"
    if ! flock -n 9; then
        echo 'Another build or update is already running for this checkout.' >&2
        exit 1
    fi
    export PINHOLE_UPDATE_LOCK_HELD=1
fi
# Omarchy's shell finds the bar widget (omarchy-bar/) among its plugins.
omarchy_plugin="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/io.github.ncr.pinhole"
# The launcher the bar widget runs: the last source installation's.
bar_launcher="${XDG_STATE_HOME:-$HOME/.local/state}/pinhole/bar-launcher"
if [ "$mode" = uninstall ]; then
    installed="$(CDPATH= cd -- "${PREFIX:-$HOME/.local}" 2>/dev/null && pwd -P || true)"
    # Its windows, the bar's follower and its service, whose plugins'
    # workers end with it: nothing of it keeps reading the library.
    if [ -n "$installed" ] && [ -f "$installed/share/pinhole/install-manifest.json" ]; then
        bin/restart-installed --stop "$installed" "$ROOT" || true
    fi
    # Only the link this installer made, never one of the person's own.
    if [ -n "$installed" ] && [ -L "$omarchy_plugin" ] && [ "$(readlink "$omarchy_plugin")" = "$installed/lib/pinhole/omarchy-bar" ]; then
        rm "$omarchy_plugin"
    fi
    if [ -n "$installed" ] && [ "$(cat "$bar_launcher" 2>/dev/null)" = "$installed/bin/pinhole" ]; then
        rm -f "$bar_launcher"
    fi
    rm -f "${PREFIX:-$HOME/.local}/share/pinhole/omarchy-bar.cksum"
    bin/uninstall-files "${PREFIX:-$HOME/.local}"
    update-desktop-database "${PREFIX:-$HOME/.local}/share/applications" 2>/dev/null || true
    exit 0
fi
run_install() {
    PREFIX="${PREFIX:-$HOME/.local}"
    install -d "$PREFIX"
    PREFIX="$(CDPATH= cd -- "$PREFIX" && pwd -P)"
    export PREFIX
    if [ "$PREFIX" = /usr ] || [ "$PREFIX" = / ]; then
        echo 'Use your OS package manager for system installations.' >&2
        exit 2
    fi
    # Keep the update lock in the installer and close it for build subprocesses.
    # bin/update has built it apart already (PINHOLE_BUILT).
    if [ "${PINHOLE_BUILT:-0}" != 1 ]; then
        python3 -c 'import subprocess, sys; sys.exit(subprocess.call(["bin/build"], close_fds=True))'
    fi
    if [ -n "${PINHOLE_EXPECTED_COMMIT:-}" ]; then
        if [ "$(git rev-parse HEAD)" != "$PINHOLE_EXPECTED_COMMIT" ] || [ -n "$(git status --porcelain)" ]; then
            echo 'Checkout changed while Pinhole was building; no installation was activated. Your edits were kept.' >&2
            exit 1
        fi
    fi
    bin/install-dev "$PREFIX"
    update-desktop-database "$PREFIX/share/applications" 2>/dev/null || true
    # On Omarchy, the bar widget: linked unless one of the person's own is
    # there (a clone they edit, a link of their dotfiles'). A link this
    # installer made points at an installation's lib/pinhole/omarchy-bar.
    # It goes on the bar with `omarchy bar put io.github.ncr.pinhole`.
    if [ -d "$(dirname -- "$(dirname -- "$omarchy_plugin")")" ]; then
        if [ ! -e "$omarchy_plugin" ] && [ ! -L "$omarchy_plugin" ]; then
            mkdir -p "$(dirname -- "$omarchy_plugin")"
            ln -s "$PREFIX/lib/pinhole/omarchy-bar" "$omarchy_plugin"
        elif [ -L "$omarchy_plugin" ] && case "$(readlink "$omarchy_plugin")" in */lib/pinhole/omarchy-bar) true ;; *) false ;; esac; then
            ln -sfn "$PREFIX/lib/pinhole/omarchy-bar" "$omarchy_plugin"
        else
            echo "Kept your own Omarchy bar widget at $omarchy_plugin."
        fi
    fi
    mkdir -p "$(dirname -- "$bar_launcher")"
    printf '%s\n' "$PREFIX/bin/pinhole" >"$bar_launcher.new"
    mv -f "$bar_launcher.new" "$bar_launcher"
    if [ "${PINHOLE_KEEP_RUNNING:-0}" != 1 ]; then
        bin/restart-installed "$PREFIX" "$ROOT"
    else
        # The window restarts itself, and its service; Omarchy's bar
        # following the library is neither, and runs what was installed.
        bin/restart-installed --followers "$PREFIX" "$ROOT"
    fi
    # Omarchy's shell keeps the types it once read (PhotoCell,
    # PinholeStore) and the words it once translated through its own
    # reload of a changed plugin, so a bar widget any of whose files is
    # other than the last installed one's needs the shell started again. Compared with what the last install wrote down, not with the
    # files before this one: a developer install links them to the
    # checkout, which a pull (or bin/update's merge) has changed already.
    # Not Pinhole's window, so also from an update in the window, which
    # keeps the window running (PINHOLE_KEEP_RUNNING) to restart it itself.
    bar_sum="$PREFIX/share/pinhole/omarchy-bar.cksum"
    bar_now=
    if [ -L "$omarchy_plugin" ] && [ -d "$PREFIX/lib/pinhole/omarchy-bar" ]; then
        bar_now="$(cd "$PREFIX/lib/pinhole/omarchy-bar" && find -L . -type f -print0 | sort -z | xargs -0 cksum | cksum)"
    fi
    if [ -n "$bar_now" ] && [ "$bar_now" != "$(cat "$bar_sum" 2>/dev/null || true)" ]; then
        if ! pgrep -u "$(id -u)" -x quickshell >/dev/null 2>&1; then
            printf '%s\n' "$bar_now" >"$bar_sum"
        elif command -v omarchy-restart-shell >/dev/null 2>&1 && omarchy-restart-shell >/dev/null 2>&1; then
            printf '%s\n' "$bar_now" >"$bar_sum"
            echo "Restarted Omarchy's shell for the new bar widget."
        else
            echo "Could not restart Omarchy's shell; the bar widget changes on its next start." >&2
        fi
    fi
    echo "Installed $(git rev-parse --short HEAD 2>/dev/null || echo 'this source') into $PREFIX (source checkout)"
    # Another Pinhole found first on PATH (a package's, an older install)
    # runs in its place in a terminal: `pinhole plugin …` is that one's.
    first="$(command -v pinhole 2>/dev/null || true)"
    if [ -n "$first" ] && [ "$first" != "$PREFIX/bin/pinhole" ]; then
        echo "Warning: $first comes before $PREFIX/bin/pinhole on PATH, so \`pinhole\` in a terminal runs that one." >&2
        if owner="$(pacman -Qqo "$first" 2>/dev/null)"; then
            echo "  It is the $owner package's: remove it with \`sudo pacman -R $owner\`." >&2
        else
            echo "  Remove it, or put $PREFIX/bin first on PATH." >&2
        fi
    fi
}
if [ "$ui" = 1 ]; then
    state="${XDG_STATE_HOME:-$HOME/.local/state}/pinhole"
    mkdir -p "$state"
    log="$state/install.log"
    gum spin --title 'Building Pinhole and linking this checkout…' --show-error -- \
        sh -c '"$1/bin/install" --non-interactive >"$2" 2>&1 || { cat "$2"; exit 1; }' sh "$ROOT" "$log"
    gum style --foreground 78 --bold '✓  Pinhole is ready.'
    # Its warnings, which the spinner kept in the log.
    grep -A1 '^Warning: ' "$log" | grep -v '^--$' >&2 || true
    gum style --faint "Build log: $log"
else
    echo 'Installing Pinhole from source…'
    run_install
    echo 'Pinhole is ready.'
fi
