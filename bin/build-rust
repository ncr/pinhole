#!/bin/sh
# Pinhole pins its compiler and daemon state together. Never silently retry
# a failed Blaze build with another compiler: Cargo is an explicit choice.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
version="$(cat "$ROOT/bin/blaze-version")"
builder="${PINHOLE_RUST_BUILDER:-blaze}"
case "$builder" in
    cargo) exec cargo "$@" ;;
    blaze | auto) ;;
    *) echo "Unknown Rust builder: $builder (use blaze or cargo)." >&2; exit 2 ;;
esac
data="${XDG_DATA_HOME:-$HOME/.local/share}/pinhole"
program="${PINHOLE_BLAZE:-$data/tools/$version/bin/blaze}"
if [ ! -x "$program" ]; then
    echo "Pinhole needs Blaze $version. Run bin/setup-blaze (or explicitly select PINHOLE_RUST_BUILDER=cargo)." >&2
    exit 127
fi
# Different releases can speak incompatible daemon protocols. BLAZE_HOME
# selects the state root; each pinned release always has a separate child.
BLAZE_HOME="${BLAZE_HOME:-$data/blaze}/$version"
export BLAZE_HOME
actual="$("$program" --version)"
case "$actual" in
    "blaze $version "* | "blaze $version") ;;
    *) echo "Pinhole needs Blaze $version; found: $actual. Run bin/setup-blaze." >&2; exit 2 ;;
esac
exec "$program" "$@"
