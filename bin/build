#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"
bin/build-rust build --release --locked --workspace --manifest-path core/Cargo.toml
bin/build-rust build --release --locked --manifest-path plugins/series/finder/Cargo.toml
bin/build-rust build --release --locked --manifest-path plugins/send/sender/Cargo.toml
app/bin/build
