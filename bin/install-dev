#!/usr/bin/env python3
"""Install launchers and links; the checkout remains the running app."""
import os
from pathlib import Path
import shlex
import subprocess
import sys

root = Path(__file__).resolve().parent.parent
prefix = Path(sys.argv[1]).absolute()
bindir = prefix / "bin"
bindir.mkdir(parents=True, exist_ok=True)
launcher = bindir / "pinhole"
# rename replaces a formerly copied executable without touching a running inode.
temporary = launcher.with_name(".pinhole-new")
temporary.write_text("#!/bin/sh\nexport PINHOLE_INSTALL_PREFIX=" + shlex.quote(str(prefix))
                     + "\nexec " + shlex.quote(str(root / "app/build/pinhole")) + ' "$@"\n')
temporary.chmod(0o755)
temporary.replace(launcher)

links = {
    "bin/pinholed": "core/target/release/pinholed",
    "bin/pinhole-auth": "plugins/icloud/auth/pyicloud/pinhole-auth",
    "bin/pinhole-update": "bin/update",
    "lib/pinhole/plugins": "plugins",
    "share/pinhole/sRGB.icc": "app/assets/sRGB.icc",
    "share/icons/hicolor/scalable/apps/pinhole.svg": "pkgbuild/pinhole.svg",
    # Plugins look beside their QML for their compiled helper.
}
for target, source in links.items():
    destination = prefix / target
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.is_dir() and not destination.is_symlink():
        # A previous copied install must remain usable until this step succeeds.
        import shutil
        shutil.rmtree(destination)
    destination.unlink(missing_ok=True)
    destination.symlink_to(root / source)
for plugin, binary in [("series", "pinhole-series"), ("send", "pinhole-send")]:
    helper = root / "plugins" / plugin / binary
    target = ("finder" if plugin == "series" else "sender") + "/target/release/" + binary
    if not helper.exists() or helper.is_symlink():
        helper.unlink(missing_ok=True)
        helper.symlink_to(target)

desktop = prefix / "share/applications/pinhole.desktop"
desktop.parent.mkdir(parents=True, exist_ok=True)
# Desktop entry quoting differs from shell quoting. Escape reserved characters.
command = str(launcher).replace("\\", "\\\\").replace('"', '\\"').replace("`", "\\`").replace("$", "\\$").replace("%", "%%")
desktop.write_text((root / "pkgbuild/pinhole.desktop").read_text().replace("Exec=pinhole", 'Exec="' + command + '"'))
subprocess.run([str(root / "bin/install-metadata"), str(prefix)], check=True,
               env={**os.environ, "PINHOLE_INSTALL_MODE": "developer"})
