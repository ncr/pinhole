#!/usr/bin/env python3
"""Offline semantic index worker, controlled by a Pinhole personal plugin."""
import argparse
import json
import os
from pathlib import Path
import sys
import hashlib
import stat
import tempfile


def endpoint(index):
    directory = Path(tempfile.gettempdir()) / ('pinhole-semantic-' + str(os.getuid()))
    directory.mkdir(mode=0o700, exist_ok=True)
    info = directory.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError('worker runtime directory must be private and owned by this user')
    return directory / (hashlib.sha256(str(index.resolve()).encode()).hexdigest()[:24] + '.sock')


def main():
    from photo_search.engines import ENGINES

    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    config = commands.add_parser('config')
    config.add_argument('--checkout', type=Path, required=True)
    config.add_argument('--library', type=Path)
    config.add_argument('--library-key')
    daemon = commands.add_parser('daemon')
    for option in ('checkout', 'library', 'managed-plugins'):
        daemon.add_argument('--' + option, type=Path, required=True)
    daemon.add_argument('--library-key', required=True)
    daemon.add_argument('--cache-dir', type=Path)
    server = commands.add_parser('serve')
    for option in ('index', 'models', 'library'):
        server.add_argument('--' + option, type=Path, required=True)
    server.add_argument('--socket', type=Path)
    server.add_argument('--library-key', required=True)
    server.add_argument('--model', choices=sorted({model for engine in ENGINES.values() for model in engine.dimensions}), required=True)
    server.add_argument('--backend', choices=ENGINES, required=True)
    server.add_argument('--cache', type=Path, default=Path('.tools/photo-search/resident-tiles'))
    server.add_argument('--ane-library', type=Path)
    server.add_argument('--compiler', type=Path)
    server.add_argument('--smoke-receipt', type=Path)
    server.add_argument('--threads', type=int, default=2)
    server.add_argument('--background', action='store_true')
    server.add_argument('--managed-plugins', type=Path)
    request = commands.add_parser('request')
    address = request.add_mutually_exclusive_group(required=True)
    address.add_argument('--socket', type=Path)
    address.add_argument('--index', type=Path)
    args = parser.parse_args()
    os.umask(0o077)
    os.environ.update(HF_HUB_OFFLINE='1', TRANSFORMERS_OFFLINE='1', HF_HUB_DISABLE_TELEMETRY='1',
                      OPENBLAS_NUM_THREADS='2', TOKENIZERS_PARALLELISM='false')
    try:
        if args.command in ('config', 'daemon'):
            from photo_search.engines import local_profile
            from photo_search.managed import index_path, service_manages
            profile = local_profile(args.checkout)
            script = str(Path(__file__).resolve())
            if args.command == 'config':
                managed = bool(args.library and args.library_key and service_manages(args.library, args.library_key))
                print(json.dumps(profile | {"worker": script, "managed": managed}))
                return 0
            python = profile["python"]
            # pinholed gives the plugin's cache for this library, the window's pinhole.cacheDir.
            index = args.cache_dir / profile["indexFile"] if args.cache_dir else index_path(args.library, profile["indexFile"])
            os.execv(python, [python, script, "serve", "--background", "--index",
                             str(index), "--library", str(args.library),
                             "--library-key", args.library_key, "--managed-plugins", str(args.managed_plugins),
                             *profile["args"]])
        if args.socket is None:
            args.socket = endpoint(args.index)
        if args.command == 'request':
            # This path imports no NumPy/Torch: UI polling is inexpensive.
            import socket
            data = sys.stdin.buffer.read((24 << 20) + 1)
            if len(data) > 24 << 20:
                raise ValueError('request too large')
            value = json.loads(data)
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
                connection.settimeout(120)
                connection.connect(str(args.socket))
                connection.sendall((json.dumps(value, ensure_ascii=False) + '\n').encode())
                response = bytearray()
                while b'\n' not in response:
                    block = connection.recv(65536)
                    if not block:
                        raise ValueError('worker disconnected')
                    response.extend(block)
                    if len(response) > 1 << 20:
                        raise ValueError('worker response too large')
                result = json.loads(response.partition(b'\n')[0])
                print(json.dumps(result, ensure_ascii=False, allow_nan=False))
                return 0 if result.get('ok') else 1
        if not 1 <= args.threads <= 4:
            raise ValueError('threads must be 1–4')
        if args.background:
            import shutil
            import subprocess
            os.nice(15)
            if hasattr(os, 'SCHED_IDLE'):
                os.sched_setscheduler(0, os.SCHED_IDLE, os.sched_param(0))
            if ionice := shutil.which('ionice'):
                subprocess.run([ionice, '-c', '3', '-p', str(os.getpid())], check=True)
        from photo_search.worker import serve
        serve(args)
        return 0
    except (OSError, ValueError, RuntimeError, KeyError, ImportError) as error:
        print(f'photo-search-worker: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
