    TestCase {
        name: "SemanticSearchIntegration"
        when: backgroundIndex.catalogReady || backgroundIndex.failure !== ""
        property string stage: "initial"
        property var details: ({})
        property var savedTag: null
        SignalSpy { id: taps; signalName: "tapped" }
        SignalSpy { id: opens; target: pinhole.viewer; signalName: "openChanged" }
        function test_pipeline() {
            compare(view.item, null, "view is lazy")
            verify(backgroundIndex.catalogReady, backgroundIndex.failure)
            compare(view.item, null, "background indexing does not create the view")
            verify(backgroundIndex.paused)
            const worker = backgroundIndex.server
            keyClick(Qt.Key_F, Qt.ControlModifier)
            tryVerify(() => view.item !== null, 5000)
            const panel = view.item
            stage = "catalog"
            tryCompare(panel, "catalogReady", true, 30000)
            compare(panel.status.total, @PHOTO_COUNT@)
            stage = "import"
            panel.importBenchmark()
            tryVerify(() => panel.status.indexed === @PHOTO_COUNT@, 30000)
            const field = findChild(panel, "semanticSearchInput")
            verify(field !== null)
            compare(field.placeholder, "Opisz zdjęcie lub wpisz #tag…")
            compare(field.height, findChild(panel, "semanticSearchClose").height)
            verify(field.width > panel.width / 2, "the question spans the window")
            stage = "query"
            field.text = @QUERY@
            panel.lookup()
            tryVerify(() => panel.results.length === Math.min(240, @PHOTO_COUNT@), 60000)
            compare(panel.results[0].id, @EXPECTED@)
            verify(panel.failure === "", panel.failure)
            stage = "keyboard"
            keyClick(Qt.Key_Down)
            compare(panel.selected, 0)
            keyClick(Qt.Key_Right)
            compare(panel.selected, 1)
            stage = "open-photo"
            keyClick(Qt.Key_Return)
            tryCompare(pinhole.viewer, "open", true, 5000)
            compare(viewer.origin.width, 0)
            compare(viewer.count, panel.results.length, "← → go through the results alone")
            compare(viewer.place, 1)
            keyClick(Qt.Key_Right)
            verify(pinhole.away, "the view waits away while the photo shows")
            keyClick(Qt.Key_Escape)
            tryVerify(() => !pinhole.away && panel.shown, 5000)
            compare(panel.selected, 2, "back on the photo last looked at")
            stage = "return-opens-best"
            field.input.forceActiveFocus()
            keyClick(Qt.Key_End)
            keyClick(Qt.Key_Return)
            tryCompare(pinhole.viewer, "open", true, 5000)
            compare(pinhole.viewer.index, pinhole.library.indexOf(panel.results[panel.selected].id))
            keyClick(Qt.Key_Escape)
            tryVerify(() => !pinhole.away && panel.shown, 5000)
            stage = "latest-query"
            field.text = @QUERY@
            panel.lookup()
            field.text = @SECOND@
            panel.lookup()
            tryVerify(() => panel.queryJob === null && panel.results.length > 0, 30000)
            compare(panel.results[0].id, @EXPECTED_SECOND@)
            stage = "catalog-cancellation"
            panel.indexer.catalog()
            panel.indexer.catalog()
            tryCompare(panel, "catalogReady", true, 30000)
            tryVerify(() => panel.results.length > 0, 30000)
            stage = "narrow-window"
            const window = panel.Window.window
            verify(window !== null)
            const oldWidth = window.width
            window.width = 420
            wait(500)
            verify(field.width > 0)
            verify(field.x + field.width <= panel.width)
            stage = "tag-suggestions"
            const tagButton = findChild(panel, "semanticTagButton")
            verify(tagButton && tagButton.visible)
            compare(tagButton.text, "Tagi")
            const tagged = panel.results[panel.selected].id
            tagButton.forceActiveFocus()
            keyClick(Qt.Key_Return)
            tryCompare(panel, "tagAsset", tagged, 5000)
            tryVerify(() => panel.tagSuggestions.length === 5, 30000, panel.tagError)
            compare(panel.savedTags.length, 0)
            const suggestion = findChild(panel, "semanticTagSuggestion")
            verify(suggestion !== null)
            suggestion.forceActiveFocus()
            keyClick(Qt.Key_Return)
            tryCompare(suggestion, "active", true, 5000)
            const saved = panel.savedTags[0].id
            keyClick(Qt.Key_Escape)
            tryCompare(panel, "tagAsset", "")
            tryCompare(findChild(panel, "semanticSearchResults"), "activeFocus", true)
            keyClick(Qt.Key_T)
            tryCompare(panel, "tagAsset", tagged)
            tryVerify(() => panel.tagSuggestions.length === 5, 30000)
            compare(panel.savedTags[0].id, saved)
            const same = findChild(panel, "semanticTagSuggestion")
            verify(same.active)
            same.forceActiveFocus()
            keyClick(Qt.Key_Return)
            tryCompare(same, "active", false)
            compare(panel.savedTags.length, 0)
            keyClick(Qt.Key_Z, Qt.ControlModifier)
            tryCompare(same, "active", true)
            keyClick(Qt.Key_Z, Qt.ControlModifier | Qt.ShiftModifier)
            tryCompare(same, "active", false)
            keyClick(Qt.Key_Return)
            tryCompare(same, "active", true)
            savedTag = {key: "tags:" + panel.sourceKey, photo: "photo:" + tagged, tag: panel.savedTags[0]}
            keyClick(Qt.Key_Escape)
            tryCompare(panel, "tagAsset", "")
            stage = "exact-tags"
            field.input.forceActiveFocus()
            field.text = "# " + savedTag.tag.label.toUpperCase()
            panel.lookup()
            tryVerify(() => panel.tagQuery && panel.results.length === 1)
            compare(panel.results[0].id, tagged)
            field.text = "# taki tag nie istnieje"
            panel.lookup()
            tryCompare(panel, "results", [])
            field.text = "#"
            panel.lookup()
            tryVerify(() => panel.results.length === 1)
            compare(panel.results[0].id, tagged)
            field.text = @SECOND@
            panel.lookup()
            tryVerify(() => !panel.tagQuery && panel.results.length > 0, 30000)
            compare(panel.results[0].id, @EXPECTED_SECOND@)
            stage = "mouse"
            const grid = findChild(panel, "semanticSearchResults")
            verify(grid !== null)
            grid.positionViewAtIndex(0, GridView.Beginning)
            grid.forceLayout()
            stage = "mouse-cell"
            tryVerify(() => grid.itemAtIndex(0) !== null, 5000)
            const cell = grid.itemAtIndex(0)
            details = {gridHeight: grid.height, gridWidth: grid.width, cellHeight: cell.height,
                       cellWidth: cell.width, position: cell.mapToItem(null, 0, 0),
                       shown: panel.shown, panelVisible: panel.visible, cellVisible: cell.visible,
                       viewerOpen: pinhole.viewer.open, windowHeight: window.height}
            stage = "mouse-move"
            mouseMove(cell, cell.width / 2, cell.height / 2)
            stage = "mouse-click"
            const tap = findChild(cell, "semanticResultTap")
            taps.target = tap
            opens.clear()
            mousePress(cell, cell.width / 2, cell.height / 2, Qt.LeftButton, Qt.NoModifier, 50)
            details = Object.assign({}, details, {pressed: tap.pressed})
            mouseRelease(cell, cell.width / 2, cell.height / 2, Qt.LeftButton, Qt.NoModifier, 50)
            details = Object.assign({}, details, {taps: taps.count, index: cell.index,
                validId: pinhole.library.indexOf(cell.modelData.id), afterPressed: tap.pressed,
                changes: opens.count, away: pinhole.away})
            stage = "mouse-viewer"
            tryCompare(pinhole.viewer, "open", true, 5000)
            compare(viewer.origin.width, 0)
            details = Object.assign({}, details, {layerBeforeEscape: keymap.layer})
            tryCompare(keymap, "layer", "viewer", 5000)
            stage = "mouse-return"
            keyClick(Qt.Key_Escape)
            details = Object.assign({}, details, {layerAfterEscape: keymap.layer,
                shownAfterEscape: panel.shown, openAfterEscape: pinhole.viewer.open})
            tryVerify(() => !pinhole.away && panel.shown, 5000)
            stage = "mouse-close-search"
            window.width = oldWidth
            keyClick(Qt.Key_Escape)
            tryCompare(panel, "shown", false, 5000)
            compare(panel.indexer.server, worker)
            stage = "reopen"
            panel.show()
            tryCompare(panel, "catalogReady", true, 30000)
            compare(panel.status.indexed, @PHOTO_COUNT@)
            stage = "quarantine"
            // The UI resumes only missing photos. Exercise the worker's
            // manual start check even though the fixture is fully imported.
            panel.indexer.request({ op: "start" }).catch(error => panel.indexer.report(error))
            tryVerify(() => panel.failure !== "", 10000)
            verify(panel.failure.includes("NPU"), panel.failure)
            stage = "offline-tags"
            panel.indexer.cancel(panel.indexer.server)
            tryCompare(panel.indexer, "server", null, 5000)
            compare(panel.catalogReady, false)
            field.input.forceActiveFocus()
            field.text = "#"
            panel.lookup()
            tryVerify(() => panel.tagQuery && panel.results.length === 1)
            compare(panel.results[0].id, tagged)
            compare(panel.queryJob, null)
            panel.close()
            stage = "complete"
        }
        function cleanupTestCase() {
            let written = false
            const data = {failed: qtest_results.failCount, passed: qtest_results.passCount,
                          stage: stage, photos: @PHOTO_COUNT@, details: details, savedTag: savedTag,
                          problem: plugins.at("me.semantic-search").problem}
            pinhole.run("/usr/bin/tee", [@RESULT_FILE@], {input: JSON.stringify(data)}).then(() => written = true)
            tryVerify(() => written, 5000)
            Qt.quit()
        }
    }
