#!/bin/sh
# Keep this developer plugin in the checkout and link it as a personal plugin.
set -eu
script=$(readlink -f -- "$0")
checkout=$(CDPATH= cd -- "$(dirname -- "$script")/../.." && pwd)
if [ "${1:-}" = config ]; then
    exec python3 "$checkout/bin/photo-search-worker" config --checkout "$checkout"
fi
exec python3 "$checkout/bin/photo-search-worker" "$@"
