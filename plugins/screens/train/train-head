#!/usr/bin/python3
"""Makes head.json, the plugin's head, from a library and a teacher.

    train-head LIBRARY TEACHER.json HEAD.json

LIBRARY is a Pinhole library's folder (library.sqlite and its thumbnails).
TEACHER.json is {id: score}, how sure a larger model is that each photo is
of a screen, as a logit (README.md says how the one for head.json was made);
a screenshot's is given as null, never one. Every thumbnail is made into
MobileNetV2's numbers as pinhole-screens makes them, and a linear head is
fitted to the teacher's likelihoods, twice on halves of the library first,
to choose the threshold by what each half finds of the other: the
likelihood from which as many are found as `--found` (2,000 by default)."""
import argparse
import base64
import json
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
import sqlite3

import numpy as np

HERE = Path(__file__).resolve().parent
loader = SourceFileLoader("pinhole_screens", str(HERE.parent / "pinhole-screens"))
worker = module_from_spec(spec_from_loader(loader.name, loader))
loader.exec_module(worker)


def fit(x, target, epochs=30, decay=1e-4, positive=3.0):
    """Adam over mini-batches, the teacher's likelihoods as targets, the
    likely ones weighing `positive` times."""
    rng = np.random.default_rng(1)
    n, d = x.shape
    weights, bias = np.zeros(d, np.float32), 0.0
    moments = [[0, 0], [0, 0]]
    step = 0
    for _ in range(epochs):
        order = rng.permutation(n)
        for start in range(0, n, 512):
            batch = order[start:start + 512]
            step += 1
            likely = 1 / (1 + np.exp(-(x[batch] @ weights + bias)))
            error = (likely - target[batch]) * (1 + (positive - 1) * target[batch]) / len(batch)
            for k, gradient in ((0, x[batch].T @ error + decay * weights), (1, error.sum())):
                moments[k][0] = 0.9 * moments[k][0] + 0.1 * gradient
                moments[k][1] = 0.999 * moments[k][1] + 0.001 * gradient ** 2
                change = 1e-3 * (moments[k][0] / (1 - 0.9 ** step)) / (np.sqrt(moments[k][1] / (1 - 0.999 ** step)) + 1e-8)
                if k == 0:
                    weights -= change
                else:
                    bias -= change
    return weights, float(bias)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("library", type=Path)
    parser.add_argument("teacher", type=Path)
    parser.add_argument("head", type=Path)
    parser.add_argument("--size", type=int, default=320)
    parser.add_argument("--found", type=int, default=2000)
    args = parser.parse_args()
    teacher = json.loads(args.teacher.read_text())
    with sqlite3.connect(f"file:{args.library / 'library.sqlite'}?mode=ro", uri=True) as catalog:
        rows = [(asset, path) for asset, path in catalog.execute(
            "SELECT id, thumb_path FROM assets WHERE is_video=0 AND thumb_path<>'' ORDER BY id") if asset in teacher]
    engine = worker.Analyzer(args.size, lambda: print("fetching the model"))
    ids, vectors = [], []
    for i, (asset, path) in enumerate(rows):
        try:
            vectors.append(np.frombuffer(engine.vector((args.library / path).read_bytes()), np.uint8))
            ids.append(asset)
        except (OSError, ValueError):
            pass
        if i % 5000 == 0:
            print(f"{i} of {len(rows)}", flush=True)
    numbers = np.stack(vectors).astype(np.float32) * worker.QUANTUM
    mean, scale = numbers.mean(0), numbers.std(0) + 1e-3
    x = (numbers - mean) / scale
    score = np.array([teacher[a] if teacher[a] is not None else -50.0 for a in ids], np.float32)
    target = 1 / (1 + np.exp(-score))
    screenshot = np.array([teacher[a] is None for a in ids])
    halves = np.random.default_rng(0).integers(0, 2, len(ids))
    other = np.zeros(len(ids), np.float32)
    for half in (0, 1):
        weights, bias = fit(x[halves != half], target[halves != half])
        other[halves == half] = x[halves == half] @ weights + bias
    ranked = np.sort(other[~screenshot])[::-1]
    least = float(ranked[min(args.found, len(ranked)) - 1])
    weights, bias = fit(x, target)
    print(f"threshold {1 / (1 + np.exp(-least)):.3f}: found {int(((x @ weights + bias >= least) & ~screenshot).sum())}")
    encode = lambda values: base64.b64encode(np.asarray(values, dtype="<f4").tobytes()).decode()
    args.head.write_text(json.dumps(dict(recipe=worker.RECIPE, size=args.size, mean=encode(mean), scale=encode(scale),
                                         weights=encode(weights), bias=bias,
                                         threshold=1 / (1 + np.exp(-least)))) + "\n")


if __name__ == "__main__":
    main()
