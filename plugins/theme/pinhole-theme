#!/bin/bash
# The Theme plugin's hands on the desktop: Omarchy's theme folder written,
# and the theme set, as omarchy-theme-set reads one (a user theme is
# ~/.config/omarchy/themes/<name>/ with colors.toml, backgrounds/ and a
# preview.png, all copied over the official theme of that name, if any).
#
#   pinhole-theme available
#   pinhole-theme current
#   pinhole-theme make <name> <photo> <icon theme> <keep> <swatch>... < colors.toml
#   pinhole-theme set <name>
set -euo pipefail

# Launched from the app launcher, Pinhole may not have Omarchy's PATH.
export OMARCHY_PATH="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
[[ -d $OMARCHY_PATH ]] || OMARCHY_PATH=/usr/share/omarchy
export PATH="$OMARCHY_PATH/bin:$PATH"

# Omarchy's home: the desktop's, or for a test one of its own
# (PINHOLE_OMARCHY_HOME), set headless there so the desktop keeps its theme
# while Pinhole watches that one (PINHOLE_THEME_DIR).
OMARCHY_HOME="${PINHOLE_OMARCHY_HOME:-$HOME}"
[[ -z ${PINHOLE_OMARCHY_HOME:-} ]] || export OMARCHY_THEME_HEADLESS=1
THEMES="$OMARCHY_HOME/.config/omarchy/themes"
# The themes Pinhole made, each marked with this file: the photo's name, and
# the name the theme was made as (name=), so a copy of one under another
# name is the user's, never pruned. How many of them are kept.
MARK=.pinhole
KEPT=12
# Where a theme is built before it is swapped in: beside the themes, on the
# same disk, out of omarchy-theme-list's sight (it lists dot-folders too).
BUILD="$OMARCHY_HOME/.config/omarchy/.pinhole-build"

current() {
  local name
  name=$(cat "$OMARCHY_HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || true)
  [[ -n $name ]] || name=$(HOME="$OMARCHY_HOME" omarchy-theme-current)
  echo "$name"
}

# A theme of Pinhole's own in use, made fresh by its mark's time, so the
# newest are the ones last used: one picked in Omarchy's picker as much as
# one just made.
used() {
  [[ -n $1 && -f $THEMES/$1/$MARK ]] && touch -- "$THEMES/$1/$MARK" || true
}

# Whether the theme <name> is Pinhole's own as it made it: its mark names it.
own() {
  [[ ! -L $THEMES/$1 && -f $THEMES/$1/$MARK ]] && grep -qxF -- "name=$1" "$THEMES/$1/$MARK"
}

# All but the newest of Pinhole's own: never the theme set now, nor `keep`
# (the one set before, what undo would go back to), both used just now, nor
# a theme Pinhole did not make, nor a copy of one under another name.
prune() {
  local keep="$1" now count=0 mark name
  now=$(current)
  used "$keep"
  used "$now"
  while IFS= read -r mark; do
    name=$(basename "$(dirname "$mark")")
    if [[ $name != pinhole-* ]] || ! own "$name"; then
      continue
    fi
    count=$((count + 1))
    if ((count > KEPT)) && [[ $name != "$now" && $name != "$keep" ]]; then
      rm -rf "${THEMES:?}/$name"
    fi
  done < <(ls -t "$THEMES"/pinhole-*/"$MARK" 2>/dev/null || true)
}

case "${1:-}" in
available)
  command -v omarchy-theme-set >/dev/null
  ;;
current)
  current
  ;;
make)
  name="$2" photo="$3" icons="$4" keep="$5"
  shift 5
  [[ $name =~ ^pinhole-[a-z0-9-]+$ ]] || { echo "Not a theme name: $name" >&2; exit 2; }
  # A theme of that name that is not Pinhole's own (one renamed to it) is
  # left as it is.
  if [[ -e $THEMES/$name || -L $THEMES/$name ]] && ! own "$name"; then
    echo "A theme named $name is there already, not one Pinhole made" >&2
    exit 2
  fi
  mkdir -p "$THEMES" "$BUILD"
  # What a make stopped halfway left (killed, its window closed), untouched
  # for ten minutes; and so in themes/ itself, as an older Pinhole built
  # there: .pinhole-<name>.XXXXXX, with its mark.
  find "$BUILD" -mindepth 1 -maxdepth 1 -mmin +10 -exec rm -rf {} + 2>/dev/null || true
  while IFS= read -r left; do
    [[ ! -f $left/$MARK ]] || rm -rf -- "$left"
  done < <(find "$THEMES" -mindepth 1 -maxdepth 1 -type d -name '.pinhole-*.??????' -mmin +10 2>/dev/null || true)
  # Built aside and swapped in, so a theme is never half written.
  next=$(mktemp -d "$BUILD/$name.XXXXXX")
  trap 'rm -rf "$next"' EXIT
  mkdir -p "$next/backgrounds"
  cat >"$next/colors.toml"
  printf '%s\n' "$icons" >"$next/icons.theme"
  printf 'photo=%s\nname=%s\n' "${photo##*/}" "$name" >"$next/$MARK"
  # The photo as the background: upright, at most a 4K screen's size.
  # Files through stdin and stdout, so no name (a folder's photo's) is
  # read as ImageMagick's own syntax ("50%off.jpg" is "500ff.jpg" to it).
  magick -[0] -auto-orient -resize '3840x3840>' -quality 92 jpg:- <"$photo" >"$next/backgrounds/$name.jpg"
  # The preview the theme picker shows: the photo, its palette along the
  # bottom.
  swatches=()
  for colour in "$@"; do
    swatches+=(-size 100x56 "xc:$colour")
  done
  magick - -resize '1280x720^' -gravity center -extent 1280x720 \
    \( "${swatches[@]}" +append -resize '1280x56!' \) -gravity south -composite png:- \
    <"$next/backgrounds/$name.jpg" >"$next/preview.png"
  was="$next.was"
  [[ ! -d $THEMES/$name ]] || mv "$THEMES/$name" "$was"
  mv "$next" "$THEMES/$name"
  rm -rf "$was"
  trap - EXIT
  # omarchy-theme-set says what went wrong on stdout.
  HOME="$OMARCHY_HOME" omarchy-theme-set "$name" >&2
  prune "$keep"
  ;;
set)
  # One of Pinhole's own pruned: exit 3 (only the last KEPT are kept).
  if [[ $2 == pinhole-* && ! -d $THEMES/$2 ]]; then
    echo "Only the last $KEPT themes made are kept" >&2
    exit 3
  fi
  HOME="$OMARCHY_HOME" omarchy-theme-set "$2" >&2
  used "$2"
  ;;
*)
  echo "Usage: pinhole-theme available | current | make <name> <photo> <icons> <keep> <swatch>... < colors.toml | set <name>" >&2
  exit 2
  ;;
esac
