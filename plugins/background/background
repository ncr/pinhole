#!/bin/sh
# The Background plugin's work outside QML; Series' studio sets its videos
# with it too.
#
# background keep <file> <folder> <name> <extension> own|cached
#   A photo or video from the service kept where it lasts, as a background
#   Omarchy can show, and its path said. A .jpg is the photo as it looks
#   (HEIC and the rest made a JPEG, turned upright, at most a 4K screen's
#   size: the shell draws with Qt's image readers, which know neither); a
#   .mkv a video's picture, without its sound (a background is silent), in a
#   container mpv reads whatever it came in; anything else the file as it
#   is, linked where it can be. The name ends in a few characters of the
#   rendition: its cache name, which an edit changes, or for a folder's own
#   file its time and size; so an edited photo set again is kept anew, and
#   the same one is the same file. Written aside and renamed, so the shell
#   never reads half a file. Then the folder pruned (see prune).
#
# background current
#   The theme's name, then the background set now ("" if none): the shell's
#   latest choice, which it points the link at once nothing on screen can
#   flash, else the link.
#
# background set <path> <theme>
#   Sets one, under <theme> ("" for one kept here). A theme's own background
#   is named in the current theme's folder, which a theme switch replaces:
#   under another theme now, it is looked for in that theme's own folder.
#   Exits 3 if it went with its theme, 4 if it is gone.
#
# background size <folder>
#   How many are kept there, and their bytes.
set -eu

# Omarchy's home: the desktop's, or for a test one of its own
# (PINHOLE_OMARCHY_HOME). Omarchy's shell answers whoever asks, whatever
# their HOME, so a test never calls it, nor omarchy-theme-bg-set, which asks
# it: it gives stand-ins for both in PINHOLE_OMARCHY_STUBS, and keeps its
# backgrounds in its own home, or is refused.
home=${PINHOLE_OMARCHY_HOME:-$HOME}
state="$home/.local/state/omarchy"
bg_set=omarchy-theme-bg-set
shell=omarchy-shell
if [ -n "${PINHOLE_OMARCHY_HOME:-}" ]; then
  stubs=${PINHOLE_OMARCHY_STUBS:-}
  if [ -z "$stubs" ] || [ ! -x "$stubs/omarchy-theme-bg-set" ] || [ ! -x "$stubs/omarchy-shell" ] \
    || [ "$(cd "$home" 2>/dev/null && pwd -P)" = "$(cd "$HOME" && pwd -P)" ]; then
    echo "Refused: a test's Omarchy (PINHOLE_OMARCHY_HOME, apart from \$HOME) needs stand-ins for omarchy-theme-bg-set and omarchy-shell in PINHOLE_OMARCHY_STUBS, or it would change the desktop's background" >&2
    exit 2
  fi
  bg_set="$stubs/omarchy-theme-bg-set"
  shell="$stubs/omarchy-shell"
fi

current_theme() { cat "$state/current/theme.name" 2>/dev/null || true; }
# The shell's latest choice, if it answers in time, as Omarchy's own scripts
# ask it: a hung shell must not keep B turning.
selected() { timeout 2 "$shell" shell selectedBackground 2>/dev/null || true; }

# How many stay in the folder whatever uses them, the newest.
KEPT=12
# All but the newest KEPT in <folder> (by when each was kept, its ctime: a
# linked one's mtime is its photo's), never <keep> nor one in use: the
# background set now, one a theme remembers to bring back (omarchy-theme-set
# keeps its path in theme-backgrounds/<theme>), one a link points at.
prune() {
  folder=$1 keep=$2
  [ -d "$folder" ] || return 0
  used=$(
    {
      echo "$keep"
      readlink -f "$state/current/background" 2>/dev/null || true
      selected
      cat "$state"/theme-backgrounds/* 2>/dev/null || true
      find "$home/.config/omarchy/backgrounds" "$home/.config/omarchy/themes" "$state/current" \
        -maxdepth 3 -type l -exec readlink -f {} \; 2>/dev/null || true
    } | while IFS= read -r path; do
      [ -z "$path" ] || readlink -f -- "$path" 2>/dev/null || true
    done
  )
  ls -tc -- "$folder" | grep -v '\.part$' | tail -n +$((KEPT + 1)) | while IFS= read -r name; do
    file="$folder/$name"
    if [ -f "$file" ] && [ ! -L "$file" ] && ! printf '%s\n' "$used" | grep -qxF -- "$(readlink -f -- "$file")"; then
      rm -f -- "$file"
    fi
  done
}

case "${1:-}" in
keep)
  from=$2 dir=$3 name=$4 extension=$5 own=$6
  if [ -n "${PINHOLE_OMARCHY_HOME:-}" ]; then
    case "$dir" in
      "$home"/*) ;;
      *) echo "Refused: a test keeps its backgrounds in its own home (PINHOLE_OMARCHY_HOME), not $dir" >&2; exit 2 ;;
    esac
  fi
  # Kept in Pictures/Pinhole/Backgrounds at first, where a folder source of
  # Pictures showed them as photos: moved, with Omarchy's link and what its
  # themes remember.
  old="${dir%/*}/Backgrounds"
  if [ -d "$old" ]; then
    mkdir -p "$dir"
    for file in "$old"/*; do
      [ -f "$file" ] && mv -n -- "$file" "$dir/"
    done
    for remembered in "$state"/theme-backgrounds/*; do
      [ -f "$remembered" ] && sed -i "s|^$old/|$dir/|" "$remembered"
    done
    shown=$(readlink -f "$state/current/background" 2>/dev/null || true)
    case "$shown" in
      "$old"/*) "$bg_set" "$dir/${shown##*/}" || true ;;
    esac
    rmdir "$old" 2>/dev/null || true
  fi
  # What a keep stopped halfway left (a plugin loaded again kills it before
  # it can tidy up): written to no more for a minute.
  [ -d "$dir" ] && find "$dir" -maxdepth 1 -name '*.part' -mmin +1 -delete
  stem=${from##*/}
  stem=${stem%.*}
  if [ "$own" = own ]; then
    tag=$(stat -c '%Y %s' -- "$from" | cksum | cut -d' ' -f1)
    tag=$(printf '%x' "$tag" | cut -c1-6)
  else
    tag=$(printf '%s' "$stem" | cut -c2-7)
  fi
  kept="$dir/$name $tag.$extension"
  if [ ! -s "$kept" ]; then
    mkdir -p "$dir"
    part="$kept.part"
    trap 'rm -f -- "$part"' EXIT
    case "$extension" in
      jpg) magick "$from[0]" -auto-orient -resize '3840x3840>' -quality 92 "jpg:$part" ;;
      mkv) ffmpeg -v error -y -i "$from" -map 0:v:0 -c copy -f matroska "$part" ;;
      # A hard link where the cache and Pictures share a disk: instant, no
      # room taken twice, and it stays when the cache lets its name go.
      *) ln -- "$from" "$part" 2>/dev/null || cp -- "$from" "$part" ;;
    esac
    mv -f -- "$part" "$kept"
  fi
  prune "$dir" "$kept"
  echo "$kept"
  ;;
current)
  current_theme
  chosen=$(selected)
  if [ -n "$chosen" ] && [ -f "$chosen" ]; then
    echo "$chosen"
  else
    readlink -f "$state/current/background" 2>/dev/null || echo
  fi
  ;;
set)
  path=$2 theme=$3
  case "$path" in
    "$state/current/theme/"*)
      if [ -n "$theme" ] && [ "$theme" != "$(current_theme)" ]; then
        file=${path#"$state/current/theme/"}
        path=
        for themes in "$home/.config/omarchy/themes" /usr/share/omarchy/themes; do
          if [ -f "$themes/$theme/$file" ]; then
            path="$themes/$theme/$file"
            break
          fi
        done
        [ -n "$path" ] || exit 3
      fi
      ;;
  esac
  [ -f "$path" ] || exit 4
  exec "$bg_set" "$path"
  ;;
size)
  dir=$2
  count=$(find "$dir" -maxdepth 1 -type f ! -name '*.part' 2>/dev/null | wc -l)
  bytes=$(du -sb -- "$dir" 2>/dev/null | cut -f1)
  echo "$count ${bytes:-0}"
  ;;
*)
  echo "Usage: background keep <file> <folder> <name> <extension> own|cached | current | set <path> <theme> | size <folder>" >&2
  exit 2
  ;;
esac
