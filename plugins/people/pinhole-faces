        "8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4"),
    "face_recognition_sface": ("face_recognition_sface_2021dec.onnx",
        "0ba9fbfa01b5270c96627c4ef784da859931e02f04419c829e83484087c34e79"),
}
REVISION = "48b10fa505aeb51fbd127fc60a5c660040e823b7"
LEGACY_MODELS = Path(__file__).resolve().parents[2] / ".tools/face-recognition"
# Bump when changing the models or preprocessing. Saved labels use this same
# identity, so a new model never silently moves a name to a different face.
RECIPE = "yunet-sface-v1"
SIMILARITY = 0.60
DEFAULT_GROUPING = "careful"
JOIN_THRESHOLDS = {"off": None, "careful": 0.62, "wider": 0.58}
WIDER_REVISION = 2
WIDER_EXEMPLARS = 32
CENTROID_SCREEN = 0.45
EXEMPLARS = 6
# A suggested group is shown as probably someone already named when its
# typical face is at least this close to one of theirs.
GUESS_SIMILARITY = 0.5
GUESS_SAMPLES = 6
PERSON_SAMPLES = 48
GUESS_GROUPS = 1000


def verified(path, digest):
    try:
        with path.open("rb") as file:
            return hashlib.file_digest(file, "sha256").hexdigest() == digest
    except FileNotFoundError:
        return False


def xdg(variable, fallback):
    return Path(os.environ.get(variable) or Path.home() / fallback)


def setup(progress):
    # Reuse the development prototype's verified weights where available.
    if all(verified(LEGACY_MODELS / name, digest) for name, digest in MODELS.values()):
        return LEGACY_MODELS
    models = xdg("XDG_CACHE_HOME", ".cache") / "pinhole/face-models"
    models.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (models / "download.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for folder, (name, digest) in MODELS.items():
            path = models / name
            if verified(path, digest):
                continue
            progress()
            part = path.with_suffix(".part")
            base = "https://media.githubusercontent.com/media/opencv/opencv_zoo"
            try:
                with urlopen(f"{base}/{REVISION}/models/{folder}/{name}", timeout=60) as response, part.open("wb") as file:
                    shutil.copyfileobj(response, file)
                if not verified(part, digest):
                    raise ValueError(f"SHA-256 mismatch: {name}")
                part.replace(path)
            finally:
                part.unlink(missing_ok=True)
    return models


class Analyzer:
    def __init__(self, progress):
        import cv2
        import numpy as np
        self.cv = cv2
        self.np = np
        cv2.setNumThreads(2)
        models = setup(progress)
        paths = [str(models / name) for name, _ in MODELS.values()]
        self.detector = cv2.FaceDetectorYN.create(paths[0], "", (320, 320), 0.85, 0.3, 5000)
        self.recognizer = cv2.FaceRecognizerSF.create(paths[1], "")

    def faces(self, data):
        cv, np = self.cv, self.np
        image = cv.imdecode(np.frombuffer(data, dtype=np.uint8), cv.IMREAD_COLOR)
        if image is None:
            raise ValueError("Unreadable thumbnail")
        height, width = image.shape[:2]
        if min(width, height) < 24:
            return []
        if max(width, height) > 480:
            scale = 480 / max(width, height)
            image = cv.resize(image, (max(1, round(width * scale)), max(1, round(height * scale))), interpolation=cv.INTER_AREA)
            height, width = image.shape[:2]
        self.detector.setInputSize((width, height))
        _, detections = self.detector.detect(image)
        faces = []
        if detections is None:
            return faces
        for face in sorted(detections, key=lambda row: (row[0], row[1])):
            x, y, w, h = map(float, face[:4])
            left, top = max(0, x), max(0, y)
            right, bottom = min(width, x + w), min(height, y + h)
            if min(right - left, bottom - top) < 24:
                continue
            crop = self.recognizer.alignCrop(image, face)
            vector = self.recognizer.feature(crop).flatten()
            norm = np.linalg.norm(vector)
            if norm > 0 and np.isfinite(norm):
                box = [left / width, top / height, (right - left) / width, (bottom - top) / height]
                faces.append((box, (vector / norm).astype("<f4").tobytes()))
        return faces


def index_path(cache, source):
    return cache / (RECIPE + "-" + hashlib.sha256(source.encode()).hexdigest() + ".sqlite")


def connect(cache, source):
    path = index_path(cache, source)
    cache.mkdir(parents=True, exist_ok=True, mode=0o700)
    db = sqlite3.connect(path)
    db.execute("PRAGMA journal_mode=WAL")
    db.execute("PRAGMA foreign_keys=ON")
    db.executescript("""
        CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);
        CREATE TABLE IF NOT EXISTS photos (
            id TEXT PRIMARY KEY, path TEXT NOT NULL, stamp TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS faces (
            key TEXT PRIMARY KEY, photo TEXT NOT NULL REFERENCES photos ON DELETE CASCADE,
            box TEXT NOT NULL, vector BLOB NOT NULL
        );
        CREATE INDEX IF NOT EXISTS faces_photo ON faces(photo);
        CREATE TABLE IF NOT EXISTS suggestions (
            anchor TEXT NOT NULL REFERENCES faces ON DELETE CASCADE,
            member TEXT NOT NULL REFERENCES faces ON DELETE CASCADE,
            score REAL NOT NULL,
            PRIMARY KEY (anchor, member)
        );
        CREATE INDEX IF NOT EXISTS suggestions_member ON suggestions(member);
    """)
    return db


def scan(db, library, assets, analyzer, progress):
    cached = {photo: (path, stamp) for photo, path, stamp in db.execute("SELECT * FROM photos")}
    available = set()
    failures = 0
    for index, asset in enumerate(assets, 1):
        photo, relative = asset["id"], asset["path"]
        try:
            path = (library / relative).resolve()
            if not path.is_relative_to(library):
                raise ValueError("Thumbnail outside library")
            stat = path.stat()
            stamp = f"{stat.st_mtime_ns}:{stat.st_ctime_ns}:{stat.st_size}"
            if cached.get(photo) != (relative, stamp):
                data = path.read_bytes()
                try:
                    engine = analyzer()
                except (OSError, ValueError) as error:
                    raise RuntimeError("Could not prepare the face models") from error
                try:
                    faces = engine.faces(data)
                except engine.cv.error as error:
                    raise ValueError("Unreadable thumbnail") from error
                digest = hashlib.sha256(data).hexdigest()
                db.execute("DELETE FROM meta WHERE key='suggestion-settings'")
                db.execute("DELETE FROM photos WHERE id=?", (photo,))
                db.execute("INSERT INTO photos VALUES (?,?,?)", (photo, relative, stamp))
                db.executemany("INSERT INTO faces VALUES (?,?,?,?)", (
                    (face_key(photo, digest, i), photo, json.dumps(box), vector)
                    for i, (box, vector) in enumerate(faces)
                ))
                time.sleep(0.005)
            available.add(photo)
        except (OSError, ValueError):
            failures += 1
        if index % 32 == 0:
            db.commit()
        if index % 50 == 0 or index == len(assets):
            progress(index, len(assets), failures)
    with db:
        removed = cached.keys() - available
        if removed:
            db.execute("DELETE FROM meta WHERE key='suggestion-settings'")
            db.executemany("DELETE FROM photos WHERE id=?", ((photo,) for photo in removed))
    return failures


def face_key(photo, digest, index):
    return hashlib.sha256(json.dumps([RECIPE, photo, digest, index]).encode()).hexdigest()


def face_rows(db):
    import numpy as np
    rows = db.execute("SELECT key, photo, box, vector FROM faces ORDER BY photo, key").fetchall()
    faces = [dict(key=key, id=photo, box=json.loads(box)) for key, photo, box, _ in rows]
    vectors = np.frombuffer(b"".join(row[3] for row in rows), dtype="<f4").reshape(-1, 128)
    return faces, vectors


def emit(event, **values):
    print(json.dumps(dict(event=event, **values)), flush=True)


def group_faces(faces, vectors, names, excluded):
    import numpy as np

    protected_keys = set(names) | {key for key, rejected in excluded.items() if rejected}

    def priority(i):
        face = faces[i]
        _, _, w, h = face["box"]
        return (face["key"] not in protected_keys, -w * h, face["key"])

    order = sorted(range(len(faces)), key=priority)
    free = np.ones(len(faces), dtype=bool)
    protected = {i for i in order if faces[i]["key"] in protected_keys}
    # Keep exemplars with saved edits from being absorbed by other groups.
    free[list(protected)] = False
    for start in range(0, len(order), 128):
        seeds = [i for i in order[start:start + 128] if free[i] or i in protected]
        candidates = np.flatnonzero(free)
        scores = vectors[seeds] @ vectors[candidates].T
        for seed, similarity in zip(seeds, scores):
            if not free[seed] and seed not in protected:
                continue
            free[seed] = False
            anchor = faces[seed]["key"]
            rejected = set(excluded.get(anchor, ()))
            seen = {faces[seed]["id"]}
            members = [(anchor, anchor, 1.0)]
            eligible = np.flatnonzero((similarity >= SIMILARITY) & free[candidates])
            for slot in eligible[np.argsort(-similarity[eligible], kind="stable")]:
                member = candidates[slot]
                face = faces[member]
                if face["id"] in seen or face["key"] in rejected:
                    continue
                seen.add(face["id"])
                free[member] = False
                members.append((anchor, face["key"], float(similarity[slot])))
            if len(members) > 1 or anchor in names:
                yield from members


def independent_support(pairs):
    import numpy as np

    # Discard both faces in the strongest pair before looking for support.
    first, second = np.unravel_index(pairs.argmax(), pairs.shape)
    pairs[first, :] = pairs[:, second] = 0
    return float(pairs.max())


def sampled_candidates(exemplars, threshold):
    import numpy as np

    candidates = exemplars.reshape(-1, exemplars.shape[-1])
    for start in range(0, len(exemplars), 16):
        batch = exemplars[start:start + 16]
        scores = (batch.reshape(-1, exemplars.shape[-1]) @ candidates.T).reshape(
            len(batch), EXEMPLARS, len(exemplars), EXEMPLARS).transpose(0, 2, 1, 3)
        for i, pairs_by_group in enumerate(scores, start):
            peaks = pairs_by_group.max(axis=(1, 2))
            eligible = np.flatnonzero(peaks[i + 1:] >= threshold) + i + 1
            ordered = eligible[np.argsort(-peaks[eligible], kind="stable")]
            yield ((j, independent_support(pairs_by_group[j])) for j in ordered)


def wider_candidates(exemplars, threshold):
    import numpy as np

    # Use an inexpensive group-level comparison to find promising pairs,
    # then rank them by the second independent face match.
    centres = np.array([group.mean(axis=0) for group in exemplars])
    norms = np.linalg.norm(centres, axis=1, keepdims=True)
    centres /= np.where(norms > 0, norms, 1)
    for start in range(0, len(centres), 64):
        scores = centres[start:start + 64] @ centres.T
        for i, row in enumerate(scores, start):
            matches = []
            for j in np.flatnonzero(row[i + 1:] >= CENTROID_SCREEN) + i + 1:
                pairs = exemplars[i] @ exemplars[j].T
                support = independent_support(pairs)
                if support >= threshold:
                    matches.append((j, support))
            yield sorted(matches, key=lambda match: (-match[1], match[0]))


def join_groups(faces, vectors, suggestions, protected, threshold, wider=False):
    """Join groups that have two matches between distinct faces on both sides."""
    import numpy as np

    groups = {}
    for anchor, member, score in suggestions:
        if anchor in protected:
            # Older labels inherit their original group's membership.
            yield anchor, member, score
        else:
            groups.setdefault(anchor, []).append((member, score))

    anchors = sorted(groups, key=lambda anchor: (-len(groups[anchor]), anchor))
    if not anchors:
        return
    positions = {face["key"]: i for i, face in enumerate(faces)}
    limit = WIDER_EXEMPLARS if wider else EXEMPLARS
    exemplars = []
    photos = []
    for anchor in anchors:
        members = groups[anchor]
        # Sample the cover and faces at a range of similarities to it.
        choices = np.linspace(0, len(members) - 1, min(limit, len(members)), dtype=int)
        exemplars.append(vectors[[positions[members[j][0]] for j in choices]])
        photos.append({faces[positions[key]]["id"] for key, _ in members})

    if wider:
        candidates = wider_candidates(exemplars, threshold)
    else:
        padded = np.zeros((len(anchors), EXEMPLARS, vectors.shape[1]), dtype=vectors.dtype)
        for i, group in enumerate(exemplars):
            padded[i, :len(group)] = group
        candidates = sampled_candidates(padded, threshold)

    absorbed = set()
    for i, matches in enumerate(candidates):
        if i in absorbed:
            continue
        anchor = anchors[i]
        seen = photos[i].copy()
        yield from ((anchor, member, score) for member, score in groups[anchor])
        for j, support in matches:
            if j in absorbed or support < threshold or seen & photos[j]:
                continue
            absorbed.add(j)
            seen.update(photos[j])
            # Later groups still have to match this anchor's original
            # exemplars. Faces added here cannot start a chain of joins.
            for member, score in groups[anchors[j]]:
                yield anchor, member, min(score, support)


def rebuild(db, names, excluded, grouping, progress):
    wider = grouping == "wider"
    inputs = [sorted(names), excluded, grouping]
    if wider:
        inputs.append(WIDER_REVISION)
    settings = json.dumps(inputs, sort_keys=True)
    if db.execute("SELECT value FROM meta WHERE key='suggestion-settings'").fetchone() == (settings,):
        return
    progress()
    faces, vectors = face_rows(db)
    suggestions = group_faces(faces, vectors, names, excluded)
    threshold = JOIN_THRESHOLDS[grouping]
    if threshold is not None:
        protected = set(names) | {key for key, rejected in excluded.items() if rejected}
        suggestions = join_groups(faces, vectors, suggestions, protected, threshold, wider=wider)
    with db:
        db.execute("DELETE FROM suggestions")
        db.executemany("INSERT INTO suggestions VALUES (?,?,?)", suggestions)
        db.execute("INSERT OR REPLACE INTO meta VALUES ('suggestion-settings', ?)", (settings,))


def set_status(db, phase, **values):
    with db:
        db.execute("INSERT OR REPLACE INTO meta VALUES ('status', ?)",
                   (json.dumps(dict(phase=phase, **values)),))


def status(db):
    # Cache databases from the original plugin have no worker status.
    has_meta = db.execute("SELECT 1 FROM sqlite_master WHERE name='meta'").fetchone()
    row = db.execute("SELECT value FROM meta WHERE key='status'").fetchone() if has_meta else None
    if row:
        return json.loads(row[0])
    return dict(phase="waiting")


def review_labels(db, edits):
    # Overlay saved labels on the derived index. Explicit face assignments
    # take priority over names saved on suggested groups by older versions.
    db.execute("CREATE TEMP TABLE labels (key TEXT PRIMARY KEY, name TEXT NOT NULL)")
    db.execute("CREATE TEMP TABLE legacy (anchor TEXT PRIMARY KEY, name TEXT NOT NULL)")
    db.execute("CREATE TEMP TABLE rejected (anchor TEXT, member TEXT, PRIMARY KEY (anchor, member))")
    db.executemany("INSERT INTO labels VALUES (?,?)",
                   ((key, edit["person"]) for key, edit in edits.items() if edit.get("person")))
    db.executemany("INSERT INTO legacy VALUES (?,?)",
                   ((key, edit["name"]) for key, edit in edits.items() if edit.get("name")))
    db.executemany("INSERT OR IGNORE INTO rejected VALUES (?,?)",
                   ((key, face) for key, edit in edits.items() for face in edit.get("rejected", ())))
    # A group someone said is not a person is not guessed to be them again.
    db.execute("CREATE TEMP TABLE refused (anchor TEXT, name TEXT, PRIMARY KEY (anchor, name))")
    db.executemany("INSERT OR IGNORE INTO refused VALUES (?,?)",
                   ((key, name) for key, edit in edits.items() for name in edit.get("not", ())))
    # Groups the person did not recognise: kept apart, at the end.
    db.execute("CREATE TEMP TABLE unknown (anchor TEXT PRIMARY KEY)")
    db.executemany("INSERT OR IGNORE INTO unknown VALUES (?)",
                   ((key,) for key, edit in edits.items() if edit.get("unknown")))
    db.execute("INSERT OR IGNORE INTO labels SELECT anchor, name FROM legacy")
    db.execute("""
        INSERT OR IGNORE INTO labels
        SELECT s.member, l.name FROM legacy l JOIN suggestions s USING (anchor)
        LEFT JOIN rejected r ON r.anchor=s.anchor AND r.member=s.member
        WHERE r.member IS NULL ORDER BY s.anchor
        """)
    db.execute("""
        CREATE TEMP VIEW pending AS
        SELECT s.* FROM suggestions s LEFT JOIN labels l ON l.key=s.member
        LEFT JOIN rejected r ON r.anchor=s.anchor AND r.member=s.member
        WHERE l.key IS NULL AND r.member IS NULL
        """)


def guesses(db, anchors):
    """The named person each group most likely is: {anchor: (name, score)}.

    A group's score for a person is the median, over a few of its best
    faces, of their closest match among that person's faces.
    """
    import numpy as np
    if not anchors:
        return {}
    people = db.execute("""
        SELECT name, vector FROM (
            SELECT l.name, f.vector, row_number() OVER (PARTITION BY l.name ORDER BY f.key) AS n
            FROM labels l JOIN faces f USING (key)
        ) WHERE n <= ?
        """, (PERSON_SAMPLES,)).fetchall()
    if not people:
        return {}
    names = sorted({name for name, _ in people})
    refused = set(db.execute("SELECT anchor, name FROM refused"))
    owner = np.array([names.index(name) for name, _ in people])
    known = np.frombuffer(b"".join(vector for _, vector in people), dtype="<f4").reshape(-1, 128)
    db.execute("CREATE TEMP TABLE IF NOT EXISTS wanted (anchor TEXT PRIMARY KEY)")
    db.execute("DELETE FROM wanted")
    db.executemany("INSERT OR IGNORE INTO wanted VALUES (?)", ((anchor,) for anchor in anchors))
    rows = db.execute("""
        SELECT anchor, vector FROM (
            SELECT p.anchor, p.member, row_number() OVER (PARTITION BY p.anchor ORDER BY p.score DESC, p.member) AS n
            FROM pending p JOIN wanted USING (anchor)
        ) s JOIN faces f ON f.key=s.member WHERE n <= ? ORDER BY anchor
        """, (GUESS_SAMPLES,)).fetchall()
    if not rows:
        return {}
    group_of = [anchor for anchor, _ in rows]
    vectors = np.frombuffer(b"".join(vector for _, vector in rows), dtype="<f4").reshape(-1, 128)
    similarity = vectors @ known.T
    best = np.full((len(rows), len(names)), -1.0, dtype=np.float32)
    for person in range(len(names)):
        best[:, person] = similarity[:, owner == person].max(axis=1)
    found = {}
    start = 0
    while start < len(rows):
        end = start
        while end < len(rows) and group_of[end] == group_of[start]:
            end += 1
        scores = np.median(best[start:end], axis=0)
        for i, name in enumerate(names):
            if (group_of[start], name) in refused:
                scores[i] = -1
        person = int(np.argmax(scores))
        if scores[person] >= GUESS_SIMILARITY:
            found[group_of[start]] = (names[person], float(scores[person]))
        start = end
    return found


def with_guesses(db, rows):
    found = guesses(db, [row["anchor"] for row in rows if row["anchor"]])
    for row in rows:
        guess = found.get(row["anchor"])
        row["guess"] = guess[0] if guess else None
    return rows


def all_guesses(db):
    anchors = [anchor for (anchor,) in db.execute(
        "SELECT anchor FROM pending GROUP BY anchor ORDER BY count(*) DESC, anchor LIMIT ?", (GUESS_GROUPS,))]
    return guesses(db, anchors)


def with_likely(db, rows):
    """Each named person's count of suggested groups that look like them."""
    counts = {}
    for name, _ in all_guesses(db).values():
        counts[name] = counts.get(name, 0) + 1
    for row in rows:
        row["likely"] = counts.get(row["name"], 0)
    return rows


def likely_rows(db, person, offset, limit=48):
    """Suggested groups that are probably `person`, the likeliest first."""
    found = all_guesses(db)
    chosen = sorted((score, anchor) for anchor, (name, score) in found.items() if name == person)
    chosen = [anchor for _, anchor in reversed(chosen)][offset:offset + limit + 1]
    rows = review_rows(db, "groups", None, 0, only=chosen, limit=limit)
    order = {anchor: i for i, anchor in enumerate(chosen)}
    rows.sort(key=lambda row: order[row["anchor"]])
    for row in rows:
        row["guess"] = person
    return rows


def review_rows(db, operation, target, offset, only=None, limit=48, known=None):
    if only == []:
        return []
    if operation == "groups":
        # Use a still-unassigned face as the cover if the original anchor
        # already belongs to a person. Keep the anchor as the group identity.
        query = """
            WITH covers AS (
                SELECT anchor, member, count(*) OVER (PARTITION BY anchor) AS count,
                       row_number() OVER (PARTITION BY anchor ORDER BY score DESC, member) AS rank
                FROM pending
            )
            SELECT f.key, f.photo, f.box, p.path, c.count, c.anchor, NULL, u.anchor IS NOT NULL
            FROM covers c JOIN faces f ON f.key=c.member JOIN photos p ON p.id=f.photo
            LEFT JOIN unknown u ON u.anchor=c.anchor
            WHERE c.rank=1 {} {} ORDER BY u.anchor IS NOT NULL, c.count DESC, c.anchor LIMIT ? OFFSET ?
        """.format("" if only is None else "AND c.anchor IN ({})".format(",".join("?" * len(only))),
                   "" if known is None else "AND u.anchor IS {} NULL".format("" if known else "NOT"))
        params = (*(only or ()), limit + 1, offset)
    elif operation == "people":
        query = """
            WITH covers AS (
                SELECT l.name, min(f.key) AS key, count(DISTINCT f.photo) AS count
                FROM labels l JOIN faces f USING (key) GROUP BY l.name
            )
            SELECT f.key, f.photo, f.box, p.path, c.count, NULL, c.name, 0
            FROM covers c JOIN faces f USING (key) JOIN photos p ON p.id=f.photo
            ORDER BY c.name COLLATE NOCASE, c.name LIMIT ? OFFSET ?
        """
        params = (limit + 1, offset)
    else:
        if operation == "members":
            source = "pending s JOIN faces f ON f.key=s.member"
            where = "s.anchor=? ORDER BY (s.member=s.anchor) DESC, s.score DESC, f.key"
        else:
            source = "labels l JOIN faces f USING (key)"
            where = "l.name=? ORDER BY f.photo, f.key"
        query = f"""
            SELECT f.key, f.photo, f.box, p.path, NULL, NULL, NULL, 0
            FROM {source} JOIN photos p ON p.id=f.photo WHERE {where} LIMIT ? OFFSET ?
        """
        params = (target, limit + 1, offset)
    return [dict(key=key, id=photo, box=json.loads(box), path=path, count=count, anchor=anchor, name=name,
                 unknown=bool(unknown))
            for key, photo, box, path, count, anchor, name, unknown in db.execute(query, params)]


def assignment_keys(db, anchor):
    return [key for (key,) in db.execute("SELECT member FROM pending WHERE anchor=?", (anchor,))]


def readonly(path):
    return sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True, timeout=1)


def load_edits(path, source, previous):
    try:
        entries = json.loads(path.read_text()).get("people:" + source, {})
        # Groups with a saved word about them keep their anchor through
        # regrouping, so the word stays with the faces it was said of.
        names = sorted(key for key, edit in entries.items()
                       if edit.get("name") or edit.get("unknown") or edit.get("not"))
        excluded = {key: edit["rejected"] for key, edit in entries.items() if edit.get("rejected")}
        return names, excluded
    except FileNotFoundError:
        return [], {}
    except (OSError, ValueError, AttributeError):
        return previous


def load_grouping(path, previous):
    try:
        settings = json.loads(path.read_text()).get("settings", {}).get("pinhole.people", {})
        value = settings.get("grouping")
        return value if isinstance(value, str) and value in JOIN_THRESHOLDS else DEFAULT_GROUPING
    except FileNotFoundError:
        return DEFAULT_GROUPING
    except (OSError, ValueError, AttributeError):
        return previous


def catalog_rows(catalog, source):
    catalog.execute("BEGIN")
    try:
        owner = catalog.execute("SELECT value FROM meta WHERE key='source'").fetchone()
        if owner != (source,):
            return None
        rows = catalog.execute("""SELECT id, thumb_path FROM assets
            WHERE is_video=0 AND thumb_path IS NOT NULL AND thumb_path<>'' ORDER BY id""")
        return [dict(id=asset, path=path) for asset, path in rows]
    finally:
        catalog.rollback()


def run_index(db, library, source, settings):
    state = xdg("XDG_STATE_HOME", ".local/state") / "pinhole/plugins/pinhole.people/state.json"
    path = library / "library.sqlite"
    inode = version = catalog = None
    edits = ([], {})
    grouping = DEFAULT_GROUPING
    errors = 0
    retry = 0
    engine = None

    def analyzer():
        nonlocal engine
        if engine is None:
            engine = Analyzer(lambda: set_status(db, "models"))
        return engine

    try:
        while True:
            delay = 5
            try:
                stat = path.stat()
                identity = (stat.st_dev, stat.st_ino)
                if catalog is None or identity != inode:
                    if catalog is not None:
                        catalog.close()
                        catalog = None
                    catalog = readonly(path)
                    inode, version = identity, None
                changed = catalog.execute("PRAGMA data_version").fetchone()[0]
                saved = load_edits(state, source, edits)
                preference = load_grouping(settings, grouping)
                refresh = changed != version or (errors and time.monotonic() >= retry)
                if refresh:
                    assets = catalog_rows(catalog, source)
                    if assets is None:
                        # The daemon can be switching sources while their paths settle.
                        set_status(db, "waiting")
                        time.sleep(delay)
                        continue
                    set_status(db, "scanning", done=0, total=len(assets), errors=0)
                    errors = scan(db, library, assets, analyzer, lambda done, total, errors:
                                  set_status(db, "scanning", done=done, total=total, errors=errors))
                    retry = time.monotonic() + 60
                if refresh or saved != edits or preference != grouping:
                    # Empty libraries and old caches can be served without a runtime.
                    if db.execute("SELECT 1 FROM faces LIMIT 1").fetchone():
                        rebuild(db, *saved, preference, lambda: set_status(db, "grouping"))
                    set_status(db, "ready", errors=errors, grouping=preference)
                    version, edits, grouping = changed, saved, preference
            except ImportError as error:
                print(f"pinhole-faces: {error}", file=sys.stderr, flush=True)
                set_status(db, "runtime")
                delay = 60
            except (OSError, sqlite3.Error, RuntimeError, ValueError) as error:
                print(f"pinhole-faces: {error}: {error.__cause__ or ''}", file=sys.stderr, flush=True)
                set_status(db, "error")
                delay = 60
            time.sleep(delay)
    finally:
        if catalog is not None:
            catalog.close()


def daemon(library, source, settings, cache=None):
    # pinholed gives the plugin's cache for this library (PluginHost::cacheDir),
    # so existing face groups and labels carry over; the same when run by hand.
    library = library.absolute()
    cache = cache or (xdg("XDG_CACHE_HOME", ".cache") / "pinhole/plugins/pinhole.people"
                      / f"{library.parent.name}-{library.name}")
    cache.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (cache / (RECIPE + "-scan.lock")).open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with closing(connect(cache, source)) as db:
            run_index(db, library.resolve(), source, settings)


def exit_with_parent():
    # The service closes this pipe when it switches sources, disables the
    # plugin or exits. SQLite rolls back any unfinished batch.
    sys.stdin.buffer.read()
    os._exit(0)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=("daemon", "groups", "members", "people", "person", "likely", "assignment"))
    parser.add_argument("--cache", type=Path)
    parser.add_argument("--library", type=Path)
    parser.add_argument("--library-key")
    parser.add_argument("--managed-plugins", type=Path)
    parser.add_argument("--cache-dir", type=Path)
    args = parser.parse_args()
    os.umask(0o077)
    if args.operation == "daemon":
        if args.library is None or not args.library_key:
            parser.error("daemon requires a library and source key")
        threading.Thread(target=exit_with_parent, daemon=True).start()
        os.nice(10)
        os.environ.update(OPENBLAS_NUM_THREADS="2", OMP_NUM_THREADS="2", MKL_NUM_THREADS="2")
        settings = args.managed_plugins or xdg("XDG_CONFIG_HOME", ".config") / "pinhole/plugins.json"
        daemon(args.library, args.library_key, settings, args.cache_dir)
        return
    if args.cache is None:
        parser.error("--cache is required for this operation")
    request = json.load(sys.stdin)
    path = index_path(args.cache, request["source"])
    if not path.is_file():
        if args.operation == "assignment":
            emit(args.operation, keys=[])
        else:
            emit(args.operation, rows=[], status={"phase": "waiting"})
        return
    with closing(readonly(path)) as db, db:
        db.execute("BEGIN")
        review_labels(db, request.get("edits", {}))
        limit = max(1, min(2000, int(request.get("limit", 48))))
        if args.operation == "assignment":
            emit(args.operation, keys=assignment_keys(db, request["anchor"]))
        elif args.operation == "likely":
            emit(args.operation, rows=likely_rows(db, request["person"], request["offset"], limit), status=status(db))
        else:
            known = {"known": True, "unknown": False}.get(request.get("which"))
            rows = review_rows(db, args.operation, request.get("anchor") or request.get("person"), request["offset"],
                               limit=limit, known=known)
            if args.operation == "groups":
                rows = with_guesses(db, rows)
            elif args.operation == "people":
                rows = with_likely(db, rows)
            emit(args.operation, rows=rows, status=status(db))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, sqlite3.Error) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
