#!/bin/sh
# What Info shows of a photo, for Main.qml.
#
# pinhole-info read <image|video> <original>
#   The original's details: "image" and ImageMagick's format, size and the
#   orientation it applied, then its EXIF; or "video" and ffprobe's JSON.
#   Both read only the headers: a 12 MP HEIC takes some 20 ms, a video 60.

set -eu

case "${1:-}" in
read)
  kind="$2" original="$3"
  if [ "$kind" = video ]; then
    echo video
    ffprobe -v error -print_format json -show_format -show_streams "$original"
  else
    echo image
    # The first picture of the file (a HEIC can hold several), and the
    # orientation ImageMagick applied: libheif turns a HEIC itself, so its
    # size is as shown and its EXIF's Orientation is no longer to do.
    # On stdin: a folder's file name is never read as ImageMagick's own
    # syntax ("50%off.jpg" is "500ff.jpg" to it).
    magick identify -ping -format '%m %w %h %[orientation]\n%[EXIF:*]' -[0] < "$original"
  fi
  ;;
*)
  echo "pinhole-info read <image|video> <original>" >&2
  exit 2
  ;;
esac
