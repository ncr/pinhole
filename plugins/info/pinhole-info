#!/bin/sh
# What Info shows of a photo, for Main.qml.
#
# pinhole-info index <library.sqlite> <id> <cache folder>
#   The index's row for it as JSON (what its original is: size, width and
#   height, type, and whether it has a location), then a line "--" and the
#   cache file for what is read of that original; then, if that was read
#   before, what was.
# pinhole-info read <image|video> <original> <cache file>
#   The original's details, kept in the cache file and printed: "image" and
#   ImageMagick's EXIF, or "video" and ffprobe's JSON. Both only read the
#   headers: a 12 MP HEIC takes some 20 ms, a video 60.
set -eu

case "$1" in
index)
  db="$2" id="$3" cache="$4"
  quoted=$(printf %s "$id" | sed "s/'/''/g")
  row=$(sqlite3 -readonly -json "$db" "SELECT a.size, a.has_location AS location, a.duration, a.orientation,
      a.item_type AS type, r.width, r.height, r.file_type AS fileType, r.key
    FROM assets a LEFT JOIN renditions r ON r.asset_id = a.id AND r.kind = 'original'
    WHERE a.id = '$quoted'")
  printf '%s\n' "${row:-[]}"
  # Named by the original's key too, which changes when the file does.
  key=$(printf '%s' "$row" | sed -n 's/.*"key":"\([^"]*\)".*/\1/p')
  file="$cache/$(printf '%s:%s' "$id" "$key" | md5sum | cut -c1-32).txt"
  printf -- '--\n%s\n' "$file"
  cat "$file" 2>/dev/null || true
  ;;
read)
  kind="$2" original="$3" file="$4"
  mkdir -p "$(dirname "$file")"
  if [ "$kind" = video ]; then
    { echo video; ffprobe -v error -print_format json -show_format -show_streams "$original"; } > "$file.part" ||
      { rm -f "$file.part"; exit 1; }
  else
    # The first picture of the file: a HEIC can hold several.
    { echo image; magick identify -ping -format '%m %w %h\n%[EXIF:*]' "$original[0]"; } > "$file.part" ||
      { rm -f "$file.part"; exit 1; }
  fi
  mv "$file.part" "$file"
  cat "$file"
  ;;
*)
  echo "pinhole-info index <library.sqlite> <id> <cache folder> | read <image|video> <original> <cache file>" >&2
  exit 2
  ;;
esac
