#!/usr/bin/env python3
"""Where the window's QML spent its time, from a qmlprofiler trace (.qtd):

    app/bin/qml-hotspots trace.qtd            # the longest calls, and in each what took it
    app/bin/qml-hotspots trace.qtd --min 100  # only those of 100 ms or more

A call is a QML binding, signal handler or JavaScript function run from
C++ (not inside another): while it runs the window stands still. Within
each, the functions and bindings by their own time (not counting what they
called), with how many times each ran. app/bin/test-speed --qml-profile
makes the trace.
"""
import argparse
import collections
import xml.etree.ElementTree as ET

QML = {'Binding', 'HandlingSignal', 'Javascript', 'Creating', 'Compiling'}


def read(path):
    events, ranges = {}, []
    for _, element in ET.iterparse(path, events=('end',)):
        if element.tag == 'event':
            events[int(element.get('index'))] = {child.tag: child.text for child in element}
            element.clear()
        elif element.tag == 'range':
            duration = element.get('duration')
            index = int(element.get('eventIndex'))
            if duration is not None and events.get(index, {}).get('type') in QML:
                ranges.append((int(element.get('startTime')), int(duration), index))
            element.clear()
    ranges.sort(key=lambda r: (r[0], -r[1]))
    return events, ranges


def name(event):
    details = (event.get('details') or '').strip()
    return f"{event.get('type')} {event.get('displayname')}" + (f' {details[:60]}' if details else '')


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('trace')
    parser.add_argument('--min', type=float, default=50, help='Calls of at least this many ms (default 50).')
    parser.add_argument('--top', type=int, default=8, help='What took each, this many (default 8).')
    args = parser.parse_args()
    events, ranges = read(args.trace)
    calls, end = [], -1
    for i, (start, duration, index) in enumerate(ranges):
        if start >= end:
            calls.append(i)
            end = start + duration
    long = [i for i in calls if ranges[i][1] / 1e6 >= args.min]
    if not long:
        print(f'no call of {args.min:.0f} ms or more')
    for i in long:
        start, duration, index = ranges[i]
        print(f'{start / 1e9:8.3f} s  {duration / 1e6:6.1f} ms  {name(events[index])}')
        own, count, stack = collections.Counter(), collections.Counter(), []
        for s, d, k in ranges[i:]:
            if s >= start + duration:
                break
            while stack and stack[-1][0] + stack[-1][1] <= s:
                stack.pop()
            key = name(events[k])
            own[key] += d
            count[key] += 1
            if stack:
                own[stack[-1][2]] -= d
            stack.append((s, d, key))
        for key, ns in own.most_common(args.top):
            if ns / 1e6 >= 1:
                print(f'          {ns / 1e6:6.1f} ms  x{count[key]:<6} {key}')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
