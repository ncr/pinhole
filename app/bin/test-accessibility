#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build/accessibility-tests"
cd "$ROOT/build/accessibility-tests"
# qmake only when what it reads changed: a Makefile made again has make do
# much of it again for nothing.
if [ ! -f Makefile ] || [ "$ROOT/tests/accessibility_tests.pro" -nt Makefile ] || [ "$ROOT/src/sources.pri" -nt Makefile ]; then
    qmake6 "$ROOT/tests/accessibility_tests.pro"
fi
make -j"${PINHOLE_TEST_JOBS:-2}"
PINHOLE_X_ONLY=1 QT_QPA_PLATFORM=xcb QT_QPA_PLATFORMTHEME=generic "$ROOT/bin/headless-x" 1280x1024 ./pinhole_accessibility_tests "$@"
