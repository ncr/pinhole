#!/usr/bin/env python3
"""The window's unit tests (app/tests/pinhole_tests.cpp), built first:

    app/bin/test                  # all of them, in processes side by side
    app/bin/test someTest other   # those, in one process, as QtTest runs them

All of them run in as many processes as there are cores for, each with a
home of its own (QtTest's own files are under it, ~/.qttest), the slowest
spread first by how long each took the time before (build/tests/durations.json).
What each says is kept in build/tests/<n>.log; the failures and the totals are
said as QtTest says them. Offscreen: no window on the desktop."""
import concurrent.futures
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ET

APP = Path(__file__).resolve().parents[1]
BUILD = APP / "build/tests"
DURATIONS = BUILD / "durations.json"
ENV = {"QT_QPA_PLATFORM": "offscreen", "QT_QPA_PLATFORMTHEME": "generic"}


def build():
    BUILD.mkdir(parents=True, exist_ok=True)
    # qmake only when what it reads changed: a Makefile made again has make
    # build much of it again (half a minute) for nothing.
    makefile = BUILD / "Makefile"
    project = [APP / "tests/pinhole_tests.pro", *APP.glob("src/*.pri"), *APP.glob("tests/*.pri"), *APP.glob("*.pri")]
    if not makefile.exists() or any(p.stat().st_mtime > makefile.stat().st_mtime for p in project if p.exists()):
        subprocess.run(["qmake6", str(APP / "tests/pinhole_tests.pro")], cwd=BUILD, check=True, stdout=subprocess.DEVNULL)
    jobs = os.environ.get("PINHOLE_BUILD_JOBS") or str(os.cpu_count() or 2)
    subprocess.run(["make", "-s", f"-j{jobs}"], cwd=BUILD, check=True)


def shards(functions, count):
    """The functions in `count` groups of about the same time, the slowest
    placed first, each in the group with least so far."""
    try:
        took = json.loads(DURATIONS.read_text())
    except (OSError, ValueError):
        took = {}
    groups = [[0.0, []] for _ in range(count)]
    for name in sorted(functions, key=lambda f: -took.get(f, 1000.0)):
        least = min(groups, key=lambda g: g[0])
        least[0] += took.get(name, 1000.0)
        least[1].append(name)
    return [names for _, names in groups if names]


def run(index, names, scratch):
    home = Path(scratch) / f"home{index}"
    home.mkdir()
    env = {k: v for k, v in os.environ.items() if not k.startswith(("XDG_", "WAYLAND", "DISPLAY", "HYPRLAND"))}
    env |= ENV | {"HOME": str(home), "XDG_RUNTIME_DIR": str(home / "run")}
    (home / "run").mkdir(mode=0o700)
    report = Path(scratch) / f"{index}.xml"
    log = BUILD / f"{index}.log"
    with log.open("w") as out:
        code = subprocess.run(["./pinhole_tests", "-o", f"{report},xml", "-o", "-,txt", *names], cwd=BUILD, env=env,
                              stdout=out, stderr=subprocess.STDOUT).returncode
    return code, report, log


def main():
    build()
    if sys.argv[1:]:
        return subprocess.run(["./pinhole_tests", *sys.argv[1:]], cwd=BUILD, env=os.environ | ENV).returncode
    started = time.monotonic()
    listed = subprocess.run(["./pinhole_tests", "-functions"], cwd=BUILD, env=os.environ | ENV, capture_output=True,
                            text=True, check=True).stdout
    functions = [re.sub(r"\(\)$", "", line.strip()) for line in listed.splitlines() if line.strip().endswith("()")]
    groups = shards(functions, max(1, min(len(functions), (os.cpu_count() or 2) - 2, 14)))
    with tempfile.TemporaryDirectory(prefix="pinhole-tests-") as scratch:
        with concurrent.futures.ThreadPoolExecutor(len(groups)) as pool:
            done = list(pool.map(lambda pair: run(pair[0], pair[1], scratch), enumerate(groups)))
        counts = {"pass": 0, "fail": 0, "skip": 0}
        took, failed = {}, []
        result = re.compile(r"^(PASS   |FAIL!  |SKIP   |XPASS  ): PinholeTests::(\w+)\(")
        for code, report, log in done:
            # The time each took, for the next time's groups.
            try:
                for function in ET.parse(report).getroot().iter("TestFunction"):
                    duration = function.find("Duration")
                    if duration is not None:
                        took[function.get("name")] = float(duration.get("msecs"))
            except (OSError, ET.ParseError):
                pass
            # What it said, as QtTest says it: each result, a failure with
            # the lines that follow it.
            lines = log.read_text(errors="replace").splitlines()
            said = False
            for i, line in enumerate(lines):
                m = result.match(line)
                if not m or m.group(2) in ("initTestCase", "cleanupTestCase"):
                    continue
                kind = m.group(1).strip()
                counts["pass" if kind == "PASS" else "skip" if kind == "SKIP" else "fail"] += 1
                if kind in ("FAIL!", "XPASS"):
                    said = True
                    rest = [line]
                    for following in lines[i + 1:]:
                        if not following.startswith(" "):
                            break
                        rest.append(following)
                    failed.append("\n".join(rest))
            if code != 0 and not said:
                failed.append(f"{log}: exit {code}, no failure said:\n" + "\n".join(lines[-20:]))
    if took:
        DURATIONS.write_text(json.dumps(took, sort_keys=True, indent=0))
    for line in failed:
        print(line)
    print(f"Totals: {counts['pass']} passed, {counts['fail']} failed, {counts['skip']} skipped, 0 blacklisted, "
          f"{(time.monotonic() - started) * 1000:.0f}ms (in {len(groups)} processes)")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
