#!/usr/bin/env python3
"""Run the window's self-tests that need a library and plugins of their own,
each in a scratch profile on an X display of its own, never on the desktop
(bin/headless-x: Xvfb, or without it Hyprland's Xwayland on workspace 5):

    app/bin/test-selftests                 # all: through covering colour physics hidden stacks layers people help corner edit info sheet background clashes
    app/bin/test-selftests through layers  # some of them

The window, the service, the fake library and the plugins' helpers built
first (a few seconds when they are up to date). A fake library (pinhole-fake) with screenshots and
photos taken on this day in earlier years; Pinhole's plugins and the test
plugins (app/tests/scrolls, app/tests/layers) as the built-in ones. Info,
the contact sheet and Background on a folder of real photos instead, as a
folder source reads it; Background with an Omarchy of its own. Each
mode's log is kept in build/selftests/<mode>.log. Exits 1 if any fails.
"""
import concurrent.futures
import datetime
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
import json
import math
import os
from pathlib import Path
import shutil
import signal
import sqlite3
import struct
import subprocess
import sys
import tempfile
import threading
import time

APP = Path(__file__).resolve().parents[1]
ROOT = APP.parent
# Each in a window of its own, all at once; through as two, a width each.
# The longest first, so the last to end ends soonest.
MODES = ["through:850:panel", "through:1700:panel", "through:850:rest", "through:1700:rest", "covering", "colour", "physics", "hidden", "stacks", "layers", "people", "help", "corner",
         "edit", "info", "sheet", "background", "clashes",
         "accessibility", "guide", "lazyplugins", "querylimits", "wheelzoom"]
# On a folder of real photos (folder()), its originals there to read: the
# fake library has thumbnails alone.
ON_FOLDER = {"info", "sheet", "background"}
TEST_PLUGINS = ["scrolls", "layers"]

# clashes: what the window says of keys two have (app/tests/clashes), as
# it starts. Each line that must be in its log, any of a group; and what
# must not.
CLASHES = [
    ["test.clashes: Left is Pinhole's own key for"],
    ["test.clashes: Shift+F is People's key there too", "pinhole.people: Shift+F is Clashes test's key there too"],
    ["test.clashes: W is People's key there too", "pinhole.people: W is Clashes test's key there too"],
    ["test.clashes: Right is Pinhole's own key for"],
]
NOT_CLASHES = ["Shift+J is", "Shift+Q is"]


def library(scratch):
    fake = ROOT / "core/target/release/pinhole-fake"
    out = scratch / "library"
    subprocess.run([str(fake), "--count", "512", "--out", str(out)], check=True, stdout=subprocess.DEVNULL)
    db = sqlite3.connect(out / "library.sqlite")
    ids = [row[0] for row in db.execute("SELECT id FROM assets WHERE NOT is_video ORDER BY asset_date")]
    # Screenshots, as Screenshots knows them: by name, a phone's shape.
    # Every other photo among a dozen, each on a day of its own (photos
    # shown between hidden ones), and four a day on three days, each day's
    # one card (a stack).
    first = datetime.datetime(2024, 5, 1, 10)
    shots = [(asset, None) for asset in ids[40:64:2]] + [(asset, n) for n, asset in enumerate(ids[200:212])]
    for k, (asset, n) in enumerate(shots):
        size = "thumb_w = 222, thumb_h = 480"
        if n is None:
            db.execute(f"UPDATE assets SET filename = ?, {size} WHERE id = ?", (f"Screenshot {k:03d}.png", asset))
        else:
            when = first + datetime.timedelta(days=n // 4, minutes=n % 4)
            db.execute(f"UPDATE assets SET filename = ?, {size}, asset_date = ? WHERE id = ?",
                       (f"Screenshot {when:%Y-%m-%d at %H.%M.00}.png", int(when.timestamp() * 1000), asset))
    # On this day, in four earlier years: three photos each.
    today = datetime.datetime.now().replace(hour=12, minute=0, second=0, microsecond=0)
    for n, asset in enumerate(ids[100:112]):
        when = today.replace(year=today.year - 1 - n // 3, minute=n)
        db.execute("UPDATE assets SET asset_date = ? WHERE id = ?", (int(when.timestamp() * 1000), asset))
    db.commit()
    db.close()
    return out


def exif(make, model, when):
    """An EXIF segment (APP1) as a camera writes one: its make, its model,
    and when, as DateTime and DateTimeOriginal."""
    def ascii(text):
        return text.encode() + b"\0"
    def ifd(entries, start, tail):
        # Each entry: tag, type 2 (ASCII) or 4 (LONG), and its value, the
        # longer ones after the directory.
        body, extra = struct.pack("<H", len(entries)), b""
        after = start + 2 + 12 * len(entries) + 4
        for tag, kind, value in entries:
            if kind == 4:
                body += struct.pack("<HHII", tag, 4, 1, value)
            elif len(value) <= 4:
                body += struct.pack("<HHI", tag, 2, len(value)) + value.ljust(4, b"\0")
            else:
                body += struct.pack("<HHII", tag, 2, len(value), after + len(extra))
                extra += value + (b"\0" if len(value) % 2 else b"")
        return body + struct.pack("<I", tail) + extra
    first = ifd([(0x010F, 2, ascii(make)), (0x0110, 2, ascii(model)), (0x0132, 2, ascii(when)), (0x8769, 4, 0)], 8, 0)
    exif_at = 8 + len(first)
    first = ifd([(0x010F, 2, ascii(make)), (0x0110, 2, ascii(model)), (0x0132, 2, ascii(when)), (0x8769, 4, exif_at)], 8, 0)
    tiff = b"II*\0" + struct.pack("<I", 8) + first + ifd([(0x9003, 2, ascii(when))], exif_at, 0)
    data = b"Exif\0\0" + tiff
    return b"\xff\xe1" + struct.pack(">H", len(data) + 2) + data


def folder(scratch):
    """A folder of twelve JPEGs, as a camera leaves them (EXIF: make, model,
    when), a source of the folder kind reads; and beside it, out of it, a
    second of a background a theme switch brings (other.jpg) and a video
    for Series' studio to have made (clip.mp4). Made with ImageMagick and
    ffmpeg, which Pinhole's plugins need anyway."""
    photos = scratch / "folder"
    photos.mkdir()
    for n in range(12):
        plain = scratch / f"plain{n}.jpg"
        subprocess.run(["magick", "-size", "1600x1200", f"xc:rgb({40 + n * 17},90,{200 - n * 12})",
                        "-fill", f"rgb(230,{200 - n * 10},60)", "-draw", f"ellipse {700 + n * 30},600 400,350 0,360",
                        "-strip", "-quality", "88", str(plain)], check=True)
        jpeg = plain.read_bytes()
        when = f"2024:06:{n + 1:02d} 10:{n:02d}:00"
        (photos / f"IMG_{n:04d}.JPG").write_bytes(jpeg[:2] + exif("Pinhole", "Selftest One", when) + jpeg[2:])
        plain.unlink()
    subprocess.run(["magick", "-size", "1920x1080", "xc:rgb(20,120,90)", "-quality", "88", str(scratch / "other.jpg")],
                   check=True)
    subprocess.run(["ffmpeg", "-loglevel", "error", "-f", "lavfi", "-i", "testsrc=size=640x360:rate=24:duration=1",
                    "-pix_fmt", "yuv420p", str(scratch / "clip.mp4")], check=True)
    return photos


def omarchy(profile, scratch, env):
    """For background: an Omarchy of its own, as its check makes one: a
    home apart from HOME with its Pictures, a theme "test" whose background
    a.jpg is set, stand-ins for omarchy-theme-bg-set and omarchy-shell, and
    decoys of Omarchy's own first on PATH that only fail: never the
    desktop's."""
    home = profile / "omarchy"
    state = home / ".local/state/omarchy"
    for folder in [state / "current/theme/backgrounds", state / "theme-backgrounds", home / ".config/omarchy/backgrounds",
                   home / ".config/omarchy/themes/test/backgrounds", home / "Pictures"]:
        folder.mkdir(parents=True)
    (state / "current/theme.name").write_text("test\n")
    for theme in [state / "current/theme", home / ".config/omarchy/themes/test"]:
        shutil.copy(scratch / "other.jpg", theme / "backgrounds/a.jpg")
    (state / "current/background").symlink_to(state / "current/theme/backgrounds/a.jpg")
    stubs, decoys = profile / "stubs", profile / "decoys"
    stubs.mkdir()
    decoys.mkdir()
    (stubs / "omarchy-shell").write_text('#!/bin/sh\nexit 0\n')
    (stubs / "omarchy-theme-bg-set").write_text('#!/bin/sh\nb=$(realpath -- "$1") && [ -f "$b" ] || exit 1\n'
                                               'ln -nsf -- "$b" "$PINHOLE_OMARCHY_HOME/.local/state/omarchy/current/background"\n')
    for decoy in ["omarchy-shell", "omarchy-theme-bg-set", "omarchy-theme-set"]:
        (decoys / decoy).write_text(f'#!/bin/sh\necho "{decoy} $*" >> "{profile}/decoys.log"\nexit 1\n')
    for script in [*stubs.iterdir(), *decoys.iterdir()]:
        script.chmod(0o755)
    return {"PINHOLE_OMARCHY_HOME": str(home), "PINHOLE_OMARCHY_STUBS": str(stubs),
            "XDG_PICTURES_DIR": str(home / "Pictures"), "PATH": f"{decoys}:{env['PATH']}",
            "PINHOLE_SELFTEST_PHOTOS": "IMG_0000.JPG", "PINHOLE_SELFTEST_VIDEO": str(scratch / "clip.mp4"),
            "PINHOLE_SELFTEST_OTHER": str(scratch / "other.jpg")}


def faces(profile, lib, out):
    """For people: a face index of People's own in its cache, as its finder
    leaves one (no OpenCV needed), and a name given in what it syncs. Two
    photos: `named`, one face, Anna's; `shown`, two faces, the left one
    like Anna's, the right one like no one's. Their ids in out/people.json."""
    loader = SourceFileLoader("pinhole_faces", str(ROOT / "plugins/people/pinhole-faces"))
    worker = module_from_spec(spec_from_loader(loader.name, loader))
    loader.exec_module(worker)
    catalog = sqlite3.connect(lib / "library.sqlite")
    rows = catalog.execute("""SELECT id, thumb_path FROM assets WHERE NOT is_video AND thumb_w > thumb_h
                              ORDER BY asset_date LIMIT 2""").fetchall()
    # The library's source as the window says it (pinhole.library.key), else
    # its folder.
    word = catalog.execute("SELECT value FROM meta WHERE key='source'").fetchone()
    catalog.close()

    def vector(angle):
        values = [0.0] * 128
        if angle is None:
            values[2] = 1.0
        else:
            values[0], values[1] = math.cos(math.radians(angle)), math.sin(math.radians(angle))
        return struct.pack("<128f", *values)

    (named, named_path), (shown, shown_path) = rows
    seeded = [(named, named_path, [("anna", [0.4, 0.3, 0.2, 0.25], vector(0))]),
              (shown, shown_path, [("like-anna", [0.1, 0.2, 0.2, 0.25], vector(6)),
                                   ("no-one", [0.6, 0.2, 0.2, 0.25], vector(None))])]
    cache = profile / "cache/pinhole/plugins/pinhole.people" / f"{lib.parent.name}-{lib.name}"
    sources = {word[0]} if word and word[0] else {str(lib), str(lib.resolve())}
    for source in sources:
        db = worker.connect(cache, source)
        with db:
            for photo, path, found in seeded:
                stat = (lib / path).resolve().stat()
                db.execute("INSERT INTO photos VALUES (?,?,?)",
                           (photo, path, f"{stat.st_mtime_ns}:{stat.st_ctime_ns}:{stat.st_size}"))
                db.executemany("INSERT INTO faces VALUES (?,?,?,?)",
                               ((key, photo, json.dumps(box), data) for key, box, data in found))
            # Grouped already, as it would leave it with nothing named.
            db.execute("INSERT INTO meta VALUES ('suggestion-settings', ?)",
                       (json.dumps([[], {}, "careful"], sort_keys=True),))
            db.execute("INSERT INTO meta VALUES ('status', ?)", (json.dumps({"phase": "ready", "errors": 0}),))
        db.close()
    # The name in what People syncs of the library (synced.rs: its folder
    # named as the library's cacheDir is).
    synced = profile / "state/pinhole/synced" / f"{lib.parent.name}-{lib.name}"
    synced.mkdir(parents=True)
    (synced / "pinhole.people.json").write_text(json.dumps({"values": {"anna": {"person": "Anna"}},
                                                            "clock": {"anna": [1, "selftest"]}}))
    (out / "people.json").write_text(json.dumps({"named": named, "shown": shown}))


def build():
    """The window (and Info's module), the service, the fake library and the
    plugins' helpers, as this checkout has them: a pinholed left from an
    older checkout answers another protocol, and the window waits for
    sources that never come. A few seconds when they are up to date."""
    subprocess.run([str(APP / "bin/build")], check=True, stdout=subprocess.DEVNULL)
    for manifest in ["core/Cargo.toml", "plugins/series/finder/Cargo.toml", "plugins/send/sender/Cargo.toml"]:
        subprocess.run(["cargo", "build", "--release", "--locked", "--quiet", "--manifest-path", str(ROOT / manifest)],
                       check=True)


def plugins(scratch):
    farm = scratch / "plugins"
    farm.mkdir()
    for plugin in sorted((ROOT / "plugins").iterdir()):
        if (plugin / "manifest.json").exists():
            (farm / plugin.name).symlink_to(plugin)
    for name in TEST_PLUGINS:
        (farm / f"test-{name}").symlink_to(APP / "tests" / name)
    return farm


def stop_service(profile):
    """The profile's pinholed ended, found by its socket: one shown a
    folder's library is the shared service, which outlives its windows by
    design, and would stay running after the run otherwise."""
    socket = f"--socket\0{profile}/run/p.sock\0".encode()
    found = []
    for entry in Path("/proc").iterdir():
        if entry.name.isdigit():
            try:
                if socket in (entry / "cmdline").read_bytes():
                    found.append(int(entry.name))
            except OSError:
                pass
    for pid in found:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    deadline = time.monotonic() + 5
    while found and time.monotonic() < deadline:
        found = [pid for pid in found if Path(f"/proc/{pid}").exists()]
        time.sleep(0.1)
    for pid in found:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass


def run(job, scratch, lib, farm, logs, photos):
    # A mode, or a mode and its part ("through:850", one width of it).
    mode, _, part = job.partition(":")
    name = job.replace(":", "-")
    helper = (farm / "people/pinhole-faces").read_text().split("\n", 1)[0][2:].strip()
    if mode == "people" and subprocess.run([helper, "-c", "import numpy"], stderr=subprocess.DEVNULL).returncode != 0:
        # Who a face looks like is worked out with NumPy, as People's
        # finder needs it anyway.
        print("people: skipped (People's helper needs python-numpy)")
        return True
    profile = Path(tempfile.mkdtemp(prefix=f"{name}-", dir=scratch))
    env = {key: value for key, value in os.environ.items() if not key.startswith(("WAYLAND", "HYPRLAND", "DISPLAY"))}
    for key, folder in [("HOME", "home"), ("XDG_CONFIG_HOME", "config"), ("XDG_DATA_HOME", "data"),
                        ("XDG_CACHE_HOME", "cache"), ("XDG_STATE_HOME", "state"), ("XDG_PICTURES_DIR", "pictures"),
                        ("XDG_RUNTIME_DIR", "run")]:
        (profile / folder).mkdir(mode=0o700)
        env[key] = str(profile / folder)
    out = profile / "out"
    out.mkdir()
    env |= {"PINHOLE_BUILTIN_PLUGINS": str(farm), "PINHOLED": str(ROOT / "core/target/release/pinholed"),
            "PINHOLE_SOCKET": str(profile / "run/p.sock"), "QT_QPA_PLATFORM": "xcb", "QT_QPA_PLATFORMTHEME": "generic",
            "LIBGL_ALWAYS_SOFTWARE": "1", "QSG_RHI_BACKEND": "opengl", "QT_FORCE_STDERR_LOGGING": "1",
            "PINHOLE_MAP_TILES": "http://127.0.0.1:1/",
            # Its own Xvfb, never the desktop.
            "PINHOLE_X_ONLY": "1"}
    if mode == "through" and part:
        wide, _, section = part.partition(":")
        env["PINHOLE_SELFTEST_WIDE"] = wide
        if section:
            env["PINHOLE_SELFTEST_PART"] = section
    given = lib
    if mode == "stacks":
        # It changes the library: a copy of its own.
        given = profile / "library"
        shutil.copytree(lib, given)
    # A display of its own (bin/headless-x: Xvfb, or Hyprland's Xwayland on
    # workspace 5), which the window's environment is not given.
    command = [str(APP / "bin/headless-x"), "1600x1000", str(APP / "build/pinhole"), "--library", str(given)]
    # Every built-in on, those that start off too: the self-tests look at
    # all of them.
    (profile / "config/pinhole").mkdir(parents=True, exist_ok=True)
    switches = {"enabled": {json.loads((m).read_text()).get("id", m.parent.name): True
                            for m in farm.glob("*/manifest.json") if json.loads(m.read_text()).get("startsOff")}}
    (profile / "config/pinhole/plugins.json").write_text(json.dumps(switches))
    if mode in ON_FOLDER:
        # The folder as the source shown: its library the service's to make.
        (profile / "config/pinhole/settings.json").write_text(json.dumps({"source": {"kind": "folder", "path": str(photos)}}))
        command = command[:3]
    if mode == "background":
        env |= omarchy(profile, scratch, env)
    if mode == "hidden":
        # Screenshots hiding, what it found kept from a run before.
        (profile / "config/pinhole/plugins.json").write_text(json.dumps(switches | {"settings": {"pinhole.screenshots": {"hide": True}}}))
        subprocess.run([*command[:2], "timeout", "25", *command[2:]],
                       env=env | {"PINHOLE_SELFTEST": "lazyplugins:" + str(out)},
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if mode == "people":
        faces(profile, given, out)
    if mode == "clashes":
        # Its plugin takes others' keys: there alone. Started, the plugins
        # loaded, and quit: no test of its own.
        own = profile / "plugins"
        own.mkdir()
        for plugin in farm.iterdir():
            (own / plugin.name).symlink_to(plugin.resolve())
        (own / "test-clashes").symlink_to(APP / "tests/clashes")
        env["PINHOLE_BUILTIN_PLUGINS"] = str(own)
        env["PINHOLE_SELFTEST"] = "startup"
    else:
        env["PINHOLE_SELFTEST"] = f"{mode}:{out}" if mode not in ("covering", "physics", "stacks") else mode
    started = time.monotonic()
    with (logs / f"{name}.log").open("w") as log:
        code = subprocess.run([*command[:2], "timeout", "900", *command[2:]], env=env, stdout=log,
                              stderr=subprocess.STDOUT).returncode
        if mode == "info" and code == 0:
            # Again on the same profile: what was kept shows, the original
            # not read again.
            log.write("selftest: again, on what the first run kept\n")
            log.flush()
            code = subprocess.run([*command[:2], "timeout", "900", *command[2:]], env=env, stdout=log,
                                  stderr=subprocess.STDOUT).returncode
    stop_service(profile)
    # The pictures a mode took, kept beside its log (edit's: its photo turned
    # and cropped).
    for picture in out.glob("*.png"):
        shutil.copy(picture, logs / f"{name}-{picture.name}")
    text = (logs / f"{name}.log").read_text(errors="replace")
    failed = [line for line in text.splitlines() if "FAIL" in line or "timed out" in line]
    if mode == "info":
        reads = [line for line in text.splitlines() if "the original read this time:" in line]
        if [("this time: yes" in line) for line in reads] != [True, False]:
            failed.append("FAIL the original not read the first time alone: " + " | ".join(reads))
    if mode == "background" and (profile / "decoys.log").exists():
        failed.append("FAIL Omarchy's own called: " + (profile / "decoys.log").read_text().strip())
    if mode == "clashes":
        failed += [f"FAIL not said: {' or '.join(group)}" for group in CLASHES if not any(line in text for line in group)]
        failed += [f"FAIL said: {line.strip()}" for line in text.splitlines() if any(free in line for free in NOT_CLASHES)]
    said = [f"{name}: {'ok' if code == 0 and not failed else 'FAILED (exit %d)' % code} ({time.monotonic() - started:.0f} s)"]
    said += ["    " + line for line in failed[:12]]
    with PRINTING:
        print("\n".join(said), flush=True)
    return code == 0 and not failed


PRINTING = threading.Lock()


def main():
    # A mode named alone that has parts runs them all ("through").
    asked = sys.argv[1:]
    jobs = [job for name in asked for job in ([m for m in MODES if m.startswith(name + ":")] or [name])] if asked else MODES
    if not shutil.which("Xvfb"):
        print("test-selftests: needs Xvfb (xorg-server-xvfb): its windows are never on the desktop")
        return 2
    logs = APP / "build/selftests"
    logs.mkdir(parents=True, exist_ok=True)
    build()
    started = time.monotonic()
    with tempfile.TemporaryDirectory(prefix="pinhole-selftests-") as temporary:
        scratch = Path(temporary)
        lib, farm, photos = library(scratch), plugins(scratch), folder(scratch)
        # All at once, each in its own X server and profile: as many as
        # there are cores for, the longest first.
        workers = max(1, min(len(jobs), (os.cpu_count() or 2) // 2))
        with concurrent.futures.ThreadPoolExecutor(workers) as pool:
            results = list(pool.map(lambda job: run(job, scratch, lib, farm, logs, photos), jobs))
    print(f"{sum(results)} of {len(results)} ok in {time.monotonic() - started:.0f} s")
    return 0 if all(results) else 1


if __name__ == "__main__":
    sys.exit(main())
