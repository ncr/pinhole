#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build"
cd "$ROOT/build"

# qmake only when what it reads changed: a Makefile made again has make do
# much of it again for nothing.
if [ ! -f Makefile ] || [ "$ROOT/pinhole.pro" -nt Makefile ] || [ "$ROOT/src/sources.pri" -nt Makefile ]; then
    qmake6 "$ROOT/pinhole.pro"
fi
# The commit the binary says it is (the updater's "running" revision) is
# written by qmake, which the line above may skip: write it here too when
# HEAD moved, or an up-to-date window keeps offering an update.
version="$ROOT/build/generated/buildversion.h"
commit="$(git -C "$ROOT/.." rev-parse HEAD 2>/dev/null || true)"
wanted="$(printf '#pragma once\n#define PINHOLE_BUILD_COMMIT "%s"' "$commit")"
if [ -n "$commit" ] && [ "$(cat "$version" 2>/dev/null)" != "$wanted" ]; then
    printf '%s\n' "$wanted" > "$version"
fi
make -j"${PINHOLE_BUILD_JOBS:-$(nproc)}"

# Pinhole's own plugins' native QML modules, against the window's Qt, each
# into its plugin's qml/ (docs/plugins.md, Trust).
for module in "$ROOT"/../plugins/*/module/module.pro; do
    [ -f "$module" ] || continue
    mkdir -p "$(dirname -- "$module")/build"
    (cd "$(dirname -- "$module")/build" && qmake6 "$module" && make -j"${PINHOLE_BUILD_JOBS:-$(nproc)}")
done

# Pinhole's own plugins' shaders, baked as the window's are (sources.pri),
# each beside its source: plugins/mosaic/mosaic.frag.qsb.
qsb="$(qmake6 -query QT_HOST_BINS)/qsb"
for shader in "$ROOT"/../plugins/*/*.frag; do
    [ -f "$shader" ] || continue
    if [ ! -f "$shader.qsb" ] || [ "$shader" -nt "$shader.qsb" ]; then
        "$qsb" --glsl '300 es,150,120' --hlsl 50 --msl 12 -o "$shader.qsb" "$shader"
    fi
done

echo "Built $ROOT/build/pinhole"
