# Package maintainers build from this checkout with: cd pkgbuild && makepkg -s.
pkgname=pinhole
pkgver=1.0.0
pkgrel=1
pkgdesc='A fast, on-demand iCloud Photos browser for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'qt6-multimedia' 'qt6-multimedia-ffmpeg'
         'libjpeg-turbo' 'libheif' 'libultrahdr' 'lcms2' 'wayland' 'imagemagick' 'ffmpeg' 'xdg-desktop-portal' 'uv' 'sqlite' 'python' 'git')
optdepends=('localsend: Send to phone opens its window for a device not listed')
makedepends=('rust' 'gcc' 'make' 'wayland-protocols' 'qt6-shadertools')
# makepkg's LTO makes GCC bitcode of the C in sqlite and ring, which the
# core's linker (lld) cannot read.
options=('!lto')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  bin/build
}

package() {
  cd "$startdir/.."
  PINHOLE_INSTALL_MODE=package PINHOLE_RUNTIME_PREFIX=/usr bin/install-files "$pkgdir/usr"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
