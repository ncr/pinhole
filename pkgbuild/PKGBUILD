# Builds the package from this checkout: bin/install runs makepkg here.
pkgname=pinhole
pkgver=1.0.0
pkgrel=1
pkgdesc='A fast, on-demand iCloud Photos browser for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-multimedia' 'qt6-multimedia-ffmpeg'
         'libjpeg-turbo' 'libheif' 'wayland' 'imagemagick' 'xdg-desktop-portal' 'uv')
makedepends=('rust' 'gcc' 'make' 'wayland-protocols')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  cargo build --release --locked --manifest-path core/Cargo.toml
  app/bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 app/build/pinhole "$pkgdir/usr/bin/pinhole"
  install -Dm755 core/target/release/pinholed "$pkgdir/usr/bin/pinholed"
  install -Dm755 core/target/release/pinhole-sync "$pkgdir/usr/bin/pinhole-sync"
  # The sign-in provider: a uv script that fetches icloudpd into uv's cache
  # on first use (see auth/PROTOCOL.md).
  install -Dm755 auth/pyicloud/pinhole-auth "$pkgdir/usr/bin/pinhole-auth"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/pinhole.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/pinhole.svg"
  install -Dm644 "$startdir/pinhole.desktop" "$pkgdir/usr/share/applications/pinhole.desktop"
}
