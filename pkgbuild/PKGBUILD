# Builds the package from this checkout: bin/install runs makepkg here.
pkgname=pinhole
pkgver=1.0.0
pkgrel=1
pkgdesc='A fast, on-demand iCloud Photos browser for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'qt6-multimedia' 'qt6-multimedia-ffmpeg'
         'libjpeg-turbo' 'libheif' 'wayland' 'imagemagick' 'ffmpeg' 'xdg-desktop-portal' 'uv')
makedepends=('rust' 'gcc' 'make' 'wayland-protocols')
# makepkg's LTO makes GCC bitcode of the C in sqlite and ring, which the
# core's linker (lld) cannot read.
options=('!lto')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  cargo build --release --locked --manifest-path core/Cargo.toml
  cargo build --release --locked --manifest-path plugins/series/finder/Cargo.toml
  app/bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 app/build/pinhole "$pkgdir/usr/bin/pinhole"
  install -Dm755 core/target/release/pinholed "$pkgdir/usr/bin/pinholed"
  install -Dm755 core/target/release/pinhole-sync "$pkgdir/usr/bin/pinhole-sync"
  # The sign-in provider: a uv script that fetches icloudpd into uv's cache
  # on first use (see auth/PROTOCOL.md).
  install -Dm755 auth/pyicloud/pinhole-auth "$pkgdir/usr/bin/pinhole-auth"
  # Pinhole's own plugins (docs/plugins.md), each its folder as it is in
  # the checkout, with its helpers built.
  install -d "$pkgdir/usr/lib/pinhole/plugins/series/i18n"
  install -Dm644 -t "$pkgdir/usr/lib/pinhole/plugins/series" plugins/series/manifest.json plugins/series/*.qml \
    plugins/series/Engine.js plugins/series/grain.png
  install -Dm644 -t "$pkgdir/usr/lib/pinhole/plugins/series/i18n" plugins/series/i18n/*.json
  install -Dm755 plugins/series/finder/target/release/pinhole-series "$pkgdir/usr/lib/pinhole/plugins/series/pinhole-series"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/pinhole.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/pinhole.svg"
  install -Dm644 "$startdir/pinhole.desktop" "$pkgdir/usr/share/applications/pinhole.desktop"
}
